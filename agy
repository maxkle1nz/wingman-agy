def _swap_symlink(link_path: Path, target: str):
    """Point link_path at target atomically: build a temp link beside it, then os.replace.
    An unlink-then-symlink pair loses the old link if the second call fails."""
    tmp = link_path.with_name(f".{link_path.name}.agy-tmp-{os.getpid()}")
    try:
        if tmp.is_symlink() or tmp.exists():
            tmp.unlink()
        os.symlink(target, str(tmp))
        os.replace(str(tmp), str(link_path))
    except BaseException:
        try:
            if tmp.is_symlink():
                tmp.unlink()
        except OSError:
            pass
        raise


def _apply_install_plugin(profile: str = "default", changes: list = None):
    if changes is None:
        changes = []
    if profile not in WINGMAN_PROFILES:
        return False, changes, f"unknown wingman profile: {profile!r}"
    src = _wingman_source_dir()
    link_path = _plugins_dir() / "wingman"
    wdir = _wingman_dir()
    py_file = wdir / "python"
    if not link_path.is_symlink() and link_path.exists():
        return False, changes, f"{link_path} exists as a real file or directory"
    src_files = ("plugin.json", "hook.sh", "hook.py")
    for fname in src_files:
        if not (src / fname).is_file():
            return False, changes, f"missing wingman source file: {src / fname}"

    wdir.mkdir(parents=True, exist_ok=True)
    os.chmod(wdir, 0o700)
    py_existed = py_file.is_file() or py_file.is_symlink()
    old_py_bytes = py_file.read_bytes() if py_file.is_file() else None
    new_py_text = sys.executable + "\n"
    py_file.write_text(new_py_text, encoding="utf-8")
    os.chmod(py_file, 0o600)
    py_change = None
    if not py_existed:
        py_change = {"kind": "file-created", "path": str(py_file)}
        changes.append(py_change)
    elif old_py_bytes is not None and old_py_bytes != new_py_text.encode("utf-8"):
        # An interpreter path is not a secret, so the old one can live in the manifest.
        py_change = {
            "kind": "file-replaced",
            "path": str(py_file),
            "old_text": old_py_bytes.decode("utf-8", "replace"),
            "new_text": new_py_text,
        }
        changes.append(py_change)

    def _rollback_py():
        if not py_existed:
            try:
                py_file.unlink()
            except OSError:
                pass
        elif old_py_bytes is not None:
            py_file.write_bytes(old_py_bytes)
        if py_change is not None and py_change in changes:
            changes.remove(py_change)

    rev = _agy_git_rev()
    plugin_root = wdir / "plugin"
    plugin_root.mkdir(parents=True, exist_ok=True)
    os.chmod(plugin_root, 0o700)
    copy_dir = plugin_root / f"{rev}-{profile}"
    if link_path.is_symlink() and copy_dir.exists():
        try:
            same_as_live = _same_link_location(link_path.resolve(), copy_dir)
        except OSError:
            same_as_live = False
        if same_as_live:
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            candidate = plugin_root / f"{rev}-{profile}-{stamp}"
            n = 0
            while candidate.exists() or candidate.is_symlink():
                n += 1
                candidate = plugin_root / f"{rev}-{profile}-{stamp}-{n}"
            copy_dir = candidate
    copy_existed = copy_dir.exists() or copy_dir.is_symlink()
    if copy_existed and (copy_dir.is_symlink() or not copy_dir.is_dir()):
        _rollback_py()
        return False, changes, f"{copy_dir} exists and is not a directory"

    managed_names = ("plugin.json", "hook.sh", "hook.py", "hooks.json", "install.json", "skills/agy/SKILL.md")
    old_copy_files = {}
    skills_dir_existed = (copy_dir / "skills").exists()
    skill_sub_existed = (copy_dir / "skills" / "agy").exists()
    dir_change = None
    if copy_existed:
        for fname in managed_names:
            fp = copy_dir / fname
            if fp.is_file() and not fp.is_symlink():
                old_copy_files[fname] = (fp.read_bytes(), stat.S_IMODE(fp.stat().st_mode))
            else:
                old_copy_files[fname] = None
    else:
        copy_dir.mkdir(mode=0o755)
        dir_change = {"kind": "dir-created", "path": str(copy_dir)}
        changes.append(dir_change)

    def _rollback_copy():
        if not copy_existed:
            shutil.rmtree(copy_dir, ignore_errors=True)
        else:
            for fname, saved in old_copy_files.items():
                fp = copy_dir / fname
                if saved is None:
                    try:
                        fp.unlink()
                    except OSError:
                        pass
                else:
                    fp.parent.mkdir(parents=True, exist_ok=True)
                    fp.write_bytes(saved[0])
                    os.chmod(fp, saved[1])
            if not skill_sub_existed:
                try:
                    sub = copy_dir / "skills" / "agy"
                    if sub.is_dir() and not any(sub.iterdir()):
                        sub.rmdir()
                except OSError:
                    pass
            if not skills_dir_existed:
                try:
                    sroot = copy_dir / "skills"
                    if sroot.is_dir() and not any(sroot.iterdir()):
                        sroot.rmdir()
                except OSError:
                    pass
        if dir_change is not None and dir_change in changes:
            changes.remove(dir_change)

    try:
        for fname in src_files:
            dst = copy_dir / fname
            shutil.copy2(str(src / fname), str(dst))
            if fname in ("hook.sh", "hook.py"):
                os.chmod(dst, 0o755)
            else:
                os.chmod(dst, 0o644)

        hooks_text = _wingman_hooks_text(profile)
        hooks_path = copy_dir / "hooks.json"
        hooks_path.write_text(hooks_text, encoding="utf-8")
        os.chmod(hooks_path, 0o644)

        skill_src = _agy_skill_source()
        skill_dst = copy_dir / "skills" / "agy" / "SKILL.md"
        if skill_src.is_file():
            skill_dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(str(skill_src), str(skill_dst))
            os.chmod(skill_dst, 0o644)
        elif skill_dst.is_file() and not skill_dst.is_symlink():
            skill_dst.unlink()

        sha_map = {
            fname: _file_sha256_or_none(copy_dir / fname)
            for fname in _WINGMAN_HASHED_FILES
        }
        daemon, _daemon_err = _probe_daemon_optional()
        daemon_version = str(daemon.version or "") if daemon is not None else ""
        install_meta = {
            "rev": rev,
            "profile": profile,
            "daemon_version": daemon_version,
            "installed_at": _now_iso(),
            "sha256": sha_map,
        }
        install_path = copy_dir / "install.json"
        install_path.write_text(json.dumps(install_meta, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        os.chmod(install_path, 0o644)
    except (OSError, ValueError) as e:
        _rollback_copy()
        _rollback_py()
        return False, changes, f"failed to stage wingman copy: {e}"

    ok, err = _wingman_selftest(copy_dir, profile)
    if not ok:
        _rollback_copy()
        _rollback_py()
        return False, changes, err

    need_symlink = True
    old_target = None
    if link_path.is_symlink():
        old_target = os.readlink(link_path)
        try:
            if link_path.resolve() == copy_dir.resolve() and _wingman_link_managed_by_manifest(link_path):
                need_symlink = False
        except OSError:
            need_symlink = True
    if need_symlink:
        link_path.parent.mkdir(parents=True, exist_ok=True)
        _swap_symlink(link_path, str(copy_dir))
        changes.append({"kind": "symlink", "path": str(link_path), "target": str(copy_dir), "old_target": old_target})
    _WINGMAN_SELFTEST_CACHE.clear()
    _WINGMAN_HEALTH_CACHE.clear()
    return True, changes, ""


def _apply_scoped_approvals(backups: list, backed_up: set, run_dir: Path, changes: list = None):
    if changes is None:
        changes = []
    cfg_path = _antigravity_config()
    data, allow, err = _read_config_grants(cfg_path)
    if err is not None:
        return False, changes, f"config unreadable ({err})"
    removed = [g for g in allow if g in FULL_PERM_GRANTS]
    if removed:
        _setup_backup_file(cfg_path, backups, backed_up, run_dir, move=False)
        kept = [g for g in allow if g not in FULL_PERM_GRANTS]
        data["userSettings"]["globalPermissionGrants"]["allow"] = kept
        _write_json_atomic(cfg_path, data, preserve_mode=True)
        changes.append({"kind": "grants-removed", "path": str(cfg_path), "grants": removed})
    cp = _consent_path()
    if cp.is_file():
        dest = _setup_backup_file(cp, backups, backed_up, run_dir, move=True)
        if dest is not None:
            changes.append({"kind": "file-moved", "path": str(cp), "to": str(dest)})
    return True, changes, ""


def _apply_disable_plugin(pname: str, backups: list, backed_up: set, run_dir: Path, changes: list = None):
    if changes is None:
        changes = []
    cfg_path = _antigravity_config()
    data, _allow, err = _read_config_grants(cfg_path)
    if err is not None or not isinstance(data, dict):
        return False, changes, f"config unreadable ({err})"
    plugins = data.get("plugins") if isinstance(data.get("plugins"), dict) else {}
    entry = plugins.get(pname) if isinstance(plugins.get(pname), dict) else None
    before = entry.get("enabled") if entry is not None else None
    if before is not True:
        return False, changes, f"plugins.{pname}.enabled is no longer true"
    _setup_backup_file(cfg_path, backups, backed_up, run_dir, move=False)
    data.setdefault("plugins", {}).setdefault(pname, {})["enabled"] = False
    _write_json_atomic(cfg_path, data, preserve_mode=True)
    changes.append({
        "kind": "plugin-enabled",
        "path": str(cfg_path),
        "plugin": pname,
        "before": before,
        "after": False,
    })
    return True, changes, ""


def _apply_teach_host(host: str, backups: list, backed_up: set, run_dir: Path, changes: list = None):
    if changes is None:
        changes = []
    host_map = {h: home_fn for h, _doc_name, _disp, home_fn in _SKILL_HOSTS}
    home_fn = host_map.get(host)
    if home_fn is None:
        return False, changes, f"unknown skill host: {host!r}"
    skill_src = _agy_skill_source()
    if not skill_src.is_file():
        return False, changes, f"agy skill source missing: {skill_src}"
    try:
        src_bytes = skill_src.read_bytes()
    except OSError as e:
        return False, changes, f"could not read skill source {skill_src}: {e}"
    home = home_fn()
    if not home.is_dir():
        return False, changes, f"host home does not exist: {home}"

    skills_dir = home / "skills"
    target = skills_dir / "agy"
    state, info = _inspect_skill_target(target, src_bytes)
    if state == "current":
        return True, changes, "skipped"
    if state == "refuse":
        return False, changes, info

    created_dirs = []
    previous = None
    skill_file = target / "SKILL.md"
    if state == "absent":
        try:
            if not skills_dir.exists():
                skills_dir.mkdir(mode=0o755)
                created_dirs.append(str(skills_dir))
            target.mkdir(mode=0o755)
            created_dirs.append(str(target))
            _write_bytes_atomic(skill_file, src_bytes, mode=0o644)
        except OSError as e:
            for raw_d in reversed(created_dirs):
                d = Path(raw_d)
                try:
                    if d.is_dir() and not d.is_symlink() and not any(d.iterdir()):
                        d.rmdir()
                except OSError:
                    pass
            return False, changes, f"failed to install {skill_file}: {e}"
    elif state == "symlink":
        previous = {"symlink": info}
        try:
            target.unlink()
        except OSError as e:
            return False, changes, f"failed to replace symlink {target} -> {info}: {e}"
        try:
            target.mkdir(mode=0o755)
            created_dirs.append(str(target))
            _write_bytes_atomic(skill_file, src_bytes, mode=0o644)
        except BaseException as e:
            # Never leave the host without its previous skill link (also on Ctrl-C):
            # put it back before failing.
            restore_err = None
            try:
                if skill_file.is_file() and not skill_file.is_symlink():
                    skill_file.unlink()
                if target.is_dir() and not target.is_symlink() and not any(target.iterdir()):
                    target.rmdir()
                if not target.exists() and not target.is_symlink():
                    os.symlink(info, str(target))
            except OSError as re:
                restore_err = re
            if restore_err is None and not target.is_symlink():
                restore_err = OSError(f"{target} still holds files; link not recreated")
            if not isinstance(e, OSError):
                raise
            if restore_err is not None:
                return False, changes, (
                    f"failed to install {skill_file}: {e}; "
                    f"failed to restore symlink {target} -> {info}: {restore_err}"
                )
            return False, changes, f"failed to install {skill_file} (restored symlink {target} -> {info}): {e}"
    elif state == "differs":
        try:
            old_bytes = skill_file.read_bytes()
            old_mode = stat.S_IMODE(skill_file.stat().st_mode)
        except OSError as e:
            return False, changes, f"failed to read {skill_file}: {e}"
        old_sha = hashlib.sha256(old_bytes).hexdigest()
        try:
            bak = _setup_backup_file(skill_file, backups, backed_up, run_dir, move=False)
        except OSError as e:
            return False, changes, f"failed to back up {skill_file}: {e}"
        if bak is None:
            return False, changes, f"failed to back up {skill_file}"
        previous = {"backup": str(bak), "sha256": old_sha, "mode": old_mode}
        try:
            _write_bytes_atomic(skill_file, src_bytes, mode=0o644)
        except OSError as e:
            return False, changes, f"failed to write {skill_file}: {e}"
    else:
        try:
            _write_bytes_atomic(skill_file, src_bytes, mode=0o644)
        except OSError as e:
            return False, changes, f"failed to write {skill_file}: {e}"

    _cleanup_skill_tmp_files(target)
    changes.append({
        "kind": "skill-installed",
        "host": host,
        "path": str(target),
        "sha256": hashlib.sha256(src_bytes).hexdigest(),
        "previous": previous,
        "created_dirs": created_dirs,
    })
    return True, changes, ""


def _prompt_paste_api_key():
    """Guide the user to paste a Gemini API key and validate it (one retry on invalid)."""
    print(f"Create a key at {_AISTUDIO_APIKEY_URL}")
    if sys.platform == "darwin":
        open_ans = _ask_yes_no("Open it in the browser? [y/N] ", default_yes=False)
        if open_ans is None:
            return None, "aborted"
        if open_ans:
            try:
                _run(["open", _AISTUDIO_APIKEY_URL], timeout=10)
            except (OSError, subprocess.SubprocessError):
                pass
    for attempt in range(2):
        try:
            with warnings.catch_warnings():
                warnings.simplefilter("error", getpass.GetPassWarning)
                raw = getpass.getpass("Paste the API key from AI Studio (input hidden, Enter to skip): ")
        except getpass.GetPassWarning:
            print("", file=sys.stderr)
            _warn("refusing to read API key when terminal cannot hide input")
            return None, "aborted"
        except (EOFError, KeyboardInterrupt):
            print("", file=sys.stderr)
            return None, "aborted"
        pasted = raw.strip()
        if not pasted:
            print("skipped (no key entered)")
            return None, "skipped"
        if not _is_valid_api_key_format(pasted):
            print("invalid key format (expected 20-200 letters, digits, '.', '_' or '-')")
            if attempt == 0:
                continue
            print("skipped (invalid key twice)")
            return None, "skipped"
        status = _validate_api_key(pasted)
        if status == "valid":
            return pasted, ""
        if status == "invalid":
            print("key rejected by Gemini API (invalid)")
        else:
            print("could not validate key (network or server error)")
        if attempt == 0:
            continue
        print("skipped (invalid key twice)")
        return None, "skipped"
    return None, "skipped"


def _apply_api_key(changes: list = None):
    if changes is None:
        changes = []
    scan_ans = _ask_yes_no("Look for an existing Gemini API key on this machine? [Y/n] ", default_yes=True)
    if scan_ans is None:
        return False, changes, "aborted"

    chosen_key = None
    if scan_ans:
        candidates = _discover_api_key_candidates()
        if not candidates:
            print("no existing Gemini API key candidates found")
        else:
            for c in candidates:
                c["status"] = _validate_api_key(c["key"])
            rank = {"valid": 0, "unknown": 1, "invalid": 2}
            ordered = sorted(candidates, key=lambda c: rank.get(c["status"], 3))
            src_w = max(len("source"), max(len(c["source"]) for c in ordered))
            print(f"  {'n':>2}  {'source':<{src_w}}  {'fingerprint':<11}  status")
            for idx, c in enumerate(ordered, 1):
                print(f"  {idx:>2}  {c['source']:<{src_w}}  {c['fingerprint']:<11}  {c['status']}")
            valid = [c for c in ordered if c["status"] == "valid"]
            if len(valid) == 1:
                c = valid[0]
                use_ans = _ask_yes_no(f"Use key {c['fingerprint']} from {c['source']}? [Y/n] ", default_yes=True)
                if use_ans is None:
                    return False, changes, "aborted"
                if not use_ans:
                    print("skipped")
                    return True, changes, "skipped"
                chosen_key = c["key"]
            elif len(valid) > 1:
                while True:
                    try:
                        choice = input(f"Which key? [1-{len(valid)}, Enter = 1, s = skip] ")
                    except (EOFError, KeyboardInterrupt):
                        print("", file=sys.stderr)
                        return False, changes, "aborted"
                    s = choice.strip().lower()
                    if not s:
                        chosen_key = valid[0]["key"]
                        break
                    if s in ("s", "skip"):
                        print("skipped")
                        return True, changes, "skipped"
                    if s.isdigit() and 1 <= int(s) <= len(valid):
                        chosen_key = valid[int(s) - 1]["key"]
                        break
                    print(f"enter 1-{len(valid)}, Enter for 1, or s to skip")

    if chosen_key is None:
        chosen_key, paste_err = _prompt_paste_api_key()
        if chosen_key is None:
            if paste_err == "skipped":
                return True, changes, "skipped"
            return False, changes, paste_err

    service = API_KEY_SERVICES[0]
    account = _api_account()
    # The account name goes into the same `security -i` command line as the key, so it
    # must not carry spaces, quotes or anything else that could split or extend it.
    if not _KEYCHAIN_ACCOUNT_SAFE_RE.fullmatch(account or ""):
        return False, changes, ("unsafe Keychain account name; set AGY_API_KEY_ACCOUNT to letters, "
                                "digits, '.', '_', '@' or '-'")
    fp = _key_fingerprint(chosen_key)
    try:
        r_cur = _run(["security", "find-generic-password", "-s", service, "-a", account, "-w"])
    except (OSError, subprocess.SubprocessError) as e:
        return False, changes, f"failed to inspect Keychain: {e}"
    if r_cur.returncode == 0:
        if r_cur.stdout.strip() == chosen_key:
            print(f"key {fp} already stored in Keychain ({service}/{account})")
            return True, changes, "skipped"
        replaced = True
    elif r_cur.returncode == 44:
        replaced = False
    else:
        return False, changes, f"failed to inspect Keychain (security exited with code {r_cur.returncode})"

    stdin_cmd = f"add-generic-password -U -s {service} -a {account} -w {chosen_key}\n"
    try:
        r_store = _run(["security", "-i"], input=stdin_cmd)
    except (OSError, subprocess.SubprocessError) as e:
        return False, changes, f"failed to store key in Keychain: {e}"
    if r_store.returncode != 0:
        return False, changes, f"security -i exited with code {r_store.returncode}"

    item_change = {
        "kind": "keychain-item",
        "service": service,
        "account": account,
        "replaced": replaced,
        "fingerprint": fp,
    }
    changes.append(item_change)

    readback = _api_key(required=False)
    if not readback or _key_fingerprint(readback) != fp:
        if not replaced:
            try:
                del_r = _run(["security", "delete-generic-password", "-s", service, "-a", account])
            except (OSError, subprocess.SubprocessError):
                del_r = None
            if del_r is not None and del_r.returncode == 0:
                if item_change in changes:
                    changes.remove(item_change)
                return False, changes, "stored key could not be verified from Keychain (deleted unverified item)"
        return False, changes, "stored key could not be verified from Keychain"

    print(f"stored key {fp} in Keychain ({service}/{account})")
    return True, changes, ""


def _save_setup_manifest(run_dir: Path, manifest_actions: list, backups: list, created: str):
    manifest = {
        "version": 1,
        "created": created,
        "agy_rev": _agy_git_rev(),
        "actions": manifest_actions,
        "backups": backups,
        "undone": None,
    }
    path = run_dir / "manifest.json"
    _write_json_atomic(path, manifest)
    return path


def _cmd_setup_apply(scoped: bool = False):
    _require_human_terminal("agy setup --apply")
    actions, notes, refusals = _setup_plan(scoped=scoped)
    _render_setup_plan(actions, notes, refusals)
    if not actions:
        _print_setup_after_summary()
        return

    run_dir = None
    manifest_actions = []
    backups = []
    backed_up = set()
    had_error = False
    created = _now_iso()
    total = len(actions)

    for idx, act in enumerate(actions, 1):
        if act["kind"] == "scoped-approvals":
            if not (_wingman_healthy() and _wingman_state().get("profile") == "scoped"):
                print(f"\n[{idx}/{total}] skipping scoped-approvals (wingman scoped profile is not healthy)")
                manifest_actions.append({"id": act["id"], "title": act["title"], "applied": False, "changes": []})
                continue
        if act.get("prompt_notes"):
            print()
            for pn in act["prompt_notes"]:
                print(f"  * {pn}")
        elif act["kind"] == "disable-broken-plugins":
            print(f"\n  * {act['why']}")
        suffix = "[Y/n]" if act["default_yes"] else "[y/N]"
        ans = _ask_yes_no(f"[{idx}/{total}] {act['title']}? {suffix} ", act["default_yes"])
        if ans is None:
            print("\naborted; stopping further actions", file=sys.stderr)
            had_error = True
            break
        if not ans:
            manifest_actions.append({"id": act["id"], "title": act["title"], "applied": False, "changes": []})
            continue

        if run_dir is None:
            run_dir = _create_setup_run_dir()
        changes = []
        try:
            if act["kind"] == "install-plugin":
                ok, _ch, err = _apply_install_plugin(profile=act.get("profile") or "default", changes=changes)
            elif act["kind"] == "scoped-approvals":
                ok, _ch, err = _apply_scoped_approvals(backups, backed_up, run_dir, changes=changes)
            elif act["kind"] == "disable-broken-plugins":
                ok, _ch, err = _apply_disable_plugin(act["plugin"], backups, backed_up, run_dir, changes=changes)
            elif act["kind"] == "skill-installed":
                ok, _ch, err = _apply_teach_host(act["host"], backups, backed_up, run_dir, changes=changes)
            elif act["kind"] == "api-key":
                ok, _ch, err = _apply_api_key(changes=changes)
            else:
                ok, _ch, err = False, [], f"unknown action kind: {act['kind']}"
        except BaseException:
            if changes:
                manifest_actions.append({"id": act["id"], "title": act["title"], "applied": True, "changes": changes})
                _save_setup_manifest(run_dir, manifest_actions, backups, created)
            elif backups:
                _save_setup_manifest(run_dir, manifest_actions, backups, created)
            raise

        if not ok:
            print(f"agy: {act['id']} aborted: {err}", file=sys.stderr)
            manifest_actions.append({
                "id": act["id"],
                "title": act["title"],
                "applied": bool(changes),
                "changes": changes,
            })
            had_error = True
        elif err == "skipped":
            manifest_actions.append({"id": act["id"], "title": act["title"], "applied": False, "changes": []})
        else:
            manifest_actions.append({"id": act["id"], "title": act["title"], "applied": True, "changes": changes})
        # Saved after every action: a crash mid-run must still leave an undoable record.
        _save_setup_manifest(run_dir, manifest_actions, backups, created)

    if manifest_actions:
        if run_dir is None:
            run_dir = _create_setup_run_dir()
        manifest_path = _save_setup_manifest(run_dir, manifest_actions, backups, created)
        print(f"\nmanifest: {manifest_path}")
    _print_setup_after_summary()
    if had_error:
        sys.exit(EXIT_ERR)


def _find_latest_undoable_manifest():
    sdir = _setup_dir()
    if not sdir.is_dir():
        return None, None
    for d in sorted(sdir.iterdir(), key=lambda p: p.name, reverse=True):
        if not d.is_dir():
            continue
        mf = d / "manifest.json"
        if not mf.is_file():
            continue
        try:
            data = json.loads(mf.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(data, dict) or data.get("undone") is not None:
            continue
        actions = data.get("actions") or []
        if any(isinstance(a, dict) and a.get("applied") for a in actions):
            return mf, data
    return None, None


def _norm_no_follow(raw_path):
    if not isinstance(raw_path, str) or not raw_path:
        return None
    p = Path(raw_path).expanduser()
    if not p.is_absolute() or p.name in ("", ".", ".."):
        return None
    try:
        return p.parent.resolve() / p.name
    except OSError:
        return None


def _is_expected_under(raw_path, parent_dir: Path) -> bool:
    np = _norm_no_follow(raw_path)
    if np is None:
        return False
    try:
        rp = parent_dir.expanduser().resolve()
        return np != rp and np.is_relative_to(rp)
    except (OSError, ValueError):
        return False


def _is_expected_file(raw_path, expected: Path) -> bool:
    np = _norm_no_follow(raw_path)
    ne = _norm_no_follow(str(expected))
    return np is not None and ne is not None and np == ne


def _describe_undo_change(ch: dict) -> str:
    kind = ch.get("kind")
    if kind == "symlink":
        old_t = ch.get("old_target")
        if old_t:
            return f"restore symlink {ch.get('path')} -> {old_t}"
        return f"remove symlink {ch.get('path')}"
    if kind == "file-created":
        return f"remove file {ch.get('path')}"
    if kind == "dir-created":
        return f"remove directory {ch.get('path')}"
    if kind == "grants-removed":
        grants = ch.get("grants") or []
        return f"re-add grants to {ch.get('path')}: {', '.join(str(g) for g in grants)}"
    if kind == "file-replaced":
        return f"restore previous contents of {ch.get('path')}"
    if kind == "file-moved":
        return f"restore {ch.get('path')} from {ch.get('to')}"
    if kind == "plugin-enabled":
        return f"set plugins.{ch.get('plugin')}.enabled = {json.dumps(ch.get('before'))} in {ch.get('path')}"
    if kind == "skill-installed":
        host = ch.get("host") or "?"
        path = ch.get("path") or ""
        prev = ch.get("previous")
        if isinstance(prev, dict) and prev.get("symlink"):
            return f"restore {host} skill symlink {path} -> {prev.get('symlink')}"
        if isinstance(prev, dict) and prev.get("backup"):
            return f"restore previous {host} SKILL.md at {path}"
        return f"remove {host} skill at {path}"
    if kind == "keychain-item":
        svc = ch.get("service")
        acct = ch.get("account")
        if ch.get("replaced"):
            return f"leave Keychain item {svc} (account {acct}) as is (replaced previous value)"
        return f"delete Keychain item {svc} (account {acct}, fingerprint {ch.get('fingerprint') or '?'})"
    return f"{kind}: {ch.get('path') or ''}"


def _undo_change(ch: dict):
    if not isinstance(ch, dict):
        print("  refusing invalid manifest change entry")
        return
    kind = ch.get("kind")
    if kind == "symlink":
        raw_p = ch.get("path")
        if not _is_expected_under(raw_p, _plugins_dir()):
            print(f"  refusing unsafe symlink path in manifest: {raw_p!r}; left as is")
            return
        p = Path(raw_p)
        target = str(ch.get("target") or "")
        old_target = ch.get("old_target")
        same = False
        if p.is_symlink():
            try:
                same = os.readlink(p) == target or p.resolve() == Path(target).resolve()
            except OSError:
                same = os.readlink(p) == target
        if same:
            if old_target:
                _swap_symlink(p, str(old_target))
                print(f"  restored symlink {p} -> {old_target}")
            else:
                p.unlink()
                print(f"  removed symlink {p}")
        else:
            print(f"  {p}: changed since setup; left as is")
    elif kind == "file-created":
        raw_p = ch.get("path")
        if not _is_expected_under(raw_p, _wingman_dir()):
            print(f"  refusing unsafe file path in manifest: {raw_p!r}; left as is")
            return
        p = Path(raw_p)
        if p.is_file() or p.is_symlink():
            p.unlink()
            print(f"  removed {p}")
        else:
            print(f"  {p}: already absent")
    elif kind == "dir-created":
        raw_p = ch.get("path")
        if not _is_expected_under(raw_p, _wingman_dir()):
            print(f"  refusing unsafe dir path in manifest: {raw_p!r}; left as is")
            return
        p = Path(raw_p)
        if p.is_dir() and not p.is_symlink():
            shutil.rmtree(p)
            print(f"  removed {p}")
        else:
            print(f"  {p}: already absent")
    elif kind == "grants-removed":
        raw_p = ch.get("path")
        if not _is_expected_file(raw_p, _antigravity_config()):
            print(f"  refusing unsafe config path in manifest: {raw_p!r}; left as is")
            return
        grants = ch.get("grants")
        if not isinstance(grants, list) or not all(isinstance(g, str) and g in FULL_PERM_GRANTS for g in grants):
            print("  refusing invalid grants in manifest; left as is")
            return
        p = Path(raw_p)
        if not p.is_file():
            print(f"  {p}: missing; left as is")
            return
        data, allow, err = _read_config_grants(p)
        if err is not None:
            print(f"  {p}: unreadable ({err}); left as is")
            return
        to_add = [g for g in grants if g not in allow]
        if to_add:
            target = (data.setdefault("userSettings", {})
                          .setdefault("globalPermissionGrants", {})
                          .setdefault("allow", []))
            target.extend(to_add)
            _write_json_atomic(p, data, preserve_mode=True)
            print(f"  re-added grants to {p}: {', '.join(to_add)}")
        else:
            print(f"  {p}: grants already present")
    elif kind == "file-replaced":
        raw_p = ch.get("path")
        if not _is_expected_under(raw_p, _wingman_dir()):
            print(f"  refusing unsafe file path in manifest: {raw_p!r}; left as is")
            return
        p = Path(raw_p)
        try:
            cur = p.read_text(encoding="utf-8") if p.is_file() else None
        except OSError:
            cur = None
        if cur == ch.get("new_text"):
            p.write_text(str(ch.get("old_text") or ""), encoding="utf-8")
            print(f"  restored previous {p}")
        else:
            print(f"  {p}: changed since setup; left as is")
    elif kind == "file-moved":
        raw_p = ch.get("path")
        raw_to = ch.get("to")
        if not _is_expected_file(raw_p, _consent_path()) or not _is_expected_under(raw_to, _setup_dir()):
            print(f"  refusing unsafe file-moved paths in manifest: {raw_p!r} <- {raw_to!r}; left as is")
            return
        p = Path(raw_p)
        bak = Path(raw_to)
        if p.exists() or p.is_symlink():
            print(f"  {p}: changed since setup; left as is")
        elif not bak.is_file():
            print(f"  {bak}: backup missing; cannot restore {p}")
        else:
            p.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(str(bak), str(p))
            os.chmod(p, 0o600)
            print(f"  restored {p}")
    elif kind == "plugin-enabled":
        raw_p = ch.get("path")
        if not _is_expected_file(raw_p, _antigravity_config()):
            print(f"  refusing unsafe config path in manifest: {raw_p!r}; left as is")
            return
        p = Path(raw_p)
        pname = str(ch.get("plugin") or "")
        before = ch.get("before")
        after = ch.get("after")
        if not pname or not p.is_file():
            print(f"  {p}: missing; left as is")
            return
        data, _allow, err = _read_config_grants(p)
        if err is not None or not isinstance(data, dict):
            print(f"  {p}: unreadable ({err}); left as is")
            return
        plugins = data.get("plugins") if isinstance(data.get("plugins"), dict) else {}
        entry = plugins.get(pname) if isinstance(plugins.get(pname), dict) else None
        cur = entry.get("enabled") if entry is not None else None
        if cur is after:
            entry["enabled"] = before
            _write_json_atomic(p, data, preserve_mode=True)
            print(f"  restored plugins.{pname}.enabled = {json.dumps(before)}")
        else:
            print(f"  plugins.{pname}.enabled: changed since setup; left as is")
    elif kind == "keychain-item":
        svc = str(ch.get("service") or "")
        account = str(ch.get("account") or "")
        if svc not in API_KEY_SERVICES:
            print(f"  refusing untrusted Keychain service in manifest: {svc!r}; left as is")
            return
        if ch.get("replaced"):
            print("  the previous Keychain value cannot be restored (setup never stores secrets); left as is")
            return
        if not account or not _KEYCHAIN_ACCOUNT_SAFE_RE.fullmatch(account):
            print("  keychain-item: incomplete or unsafe account in manifest entry; left as is")
            return
        expected_fp = ch.get("fingerprint")
        if not isinstance(expected_fp, str) or len(expected_fp) != 8:
            print(f"  Keychain {svc} (account {account}): missing fingerprint in manifest; left as is")
            return
        try:
            check = _run(["security", "find-generic-password", "-s", svc, "-a", account, "-w"])
        except (OSError, subprocess.SubprocessError) as e:
            print(f"  Keychain {svc} (account {account}): check failed ({e}); left as is")
            return
        if check.returncode == 44:
            print(f"  Keychain {svc} (account {account}): already absent")
            return
        if check.returncode != 0:
            print(f"  Keychain {svc} (account {account}): check failed (rc={check.returncode}); left as is")
            return
        if _key_fingerprint(check.stdout.strip()) != expected_fp:
            print(f"  Keychain {svc} (account {account}): value changed since setup; left as is")
            return
        try:
            del_r = _run(["security", "delete-generic-password", "-s", svc, "-a", account])
        except (OSError, subprocess.SubprocessError) as e:
            print(f"  Keychain {svc} (account {account}): delete failed ({e})")
            return
        if del_r.returncode == 0:
            print(f"  deleted Keychain item {svc} (account {account})")
        else:
            print(f"  could not delete Keychain item {svc} (account {account}): {del_r.stderr.strip() or 'error'}")
    elif kind == "skill-installed":
        host = ch.get("host")
        host_map = {h: home_fn for h, _doc_name, _disp, home_fn in _SKILL_HOSTS}
        if host not in host_map:
            print(f"  refusing unknown host in manifest: {host!r}; left as is")
            return
        expected_home = host_map[host]()
        expected_skills = expected_home / "skills"
        expected_target = expected_skills / "agy"
        raw_p = ch.get("path")
        if not _is_expected_file(raw_p, expected_target):
            print(f"  refusing unsafe skill path in manifest: {raw_p!r}; left as is")
            return
        created_dirs = ch.get("created_dirs")
        if created_dirs is None:
            created_dirs = []
        if not isinstance(created_dirs, list) or not all(
            isinstance(d, str) and (_is_expected_file(d, expected_target) or _is_expected_file(d, expected_skills))
            for d in created_dirs
        ):
            print("  refusing unsafe created_dirs in manifest; left as is")
            return
        prev = ch.get("previous")
        if prev is not None:
            if not isinstance(prev, dict):
                print("  refusing invalid previous in manifest; left as is")
                return
            if "backup" in prev:
                if not _is_expected_under(prev.get("backup"), _setup_dir()):
                    print(f"  refusing unsafe skill backup path in manifest: {prev.get('backup')!r}; left as is")
                    return
                if not isinstance(prev.get("sha256"), str) or not prev.get("sha256"):
                    print("  refusing skill backup entry without sha256; left as is")
                    return
            elif "symlink" in prev:
                if not isinstance(prev.get("symlink"), str) or not prev.get("symlink"):
                    print("  refusing invalid symlink target in manifest; left as is")
                    return
            else:
                print("  refusing invalid previous in manifest; left as is")
                return
        expected_sha = ch.get("sha256")
        if not isinstance(expected_sha, str) or not expected_sha:
            print("  refusing skill-installed entry without sha256; left as is")
            return

        target = expected_target
        skill_file = target / "SKILL.md"
        if target.is_symlink() or not target.is_dir() or skill_file.is_symlink() or not skill_file.is_file():
            print(f"  {skill_file}: changed since setup; left as is")
            return
        try:
            cur_sha = hashlib.sha256(skill_file.read_bytes()).hexdigest()
        except OSError:
            print(f"  {skill_file}: changed since setup; left as is")
            return
        if cur_sha != expected_sha:
            print(f"  {skill_file}: changed since setup; left as is")
            return

        if prev is None:
            skill_file.unlink()
            print(f"  removed {skill_file}")
            for raw_d in reversed(created_dirs):
                d = Path(raw_d)
                if d.is_dir() and not d.is_symlink():
                    try:
                        if not any(d.iterdir()):
                            d.rmdir()
                    except OSError:
                        pass
        elif "symlink" in prev:
            old_target = prev["symlink"]
            try:
                others = [
                    e for e in target.iterdir()
                    if e.name != "SKILL.md" and not _is_ignorable_skill_entry(e)
                ]
            except OSError:
                print(f"  {target}: changed since setup; left as is")
                return
            if others:
                print(f"  {target}: changed since setup; left as is")
                return
            aside = target.parent / f".{target.name}.agy-undo-{os.getpid()}"
            n = 0
            while aside.exists() or aside.is_symlink():
                n += 1
                aside = target.parent / f".{target.name}.agy-undo-{os.getpid()}-{n}"
            try:
                os.rename(str(target), str(aside))
            except OSError as e:
                print(f"  {target}: cannot replace directory ({e}); left as is")
                return
            try:
                os.symlink(old_target, str(target))
            except OSError as e:
                try:
                    os.rename(str(aside), str(target))
                except OSError as re:
                    print(f"  {target}: failed to restore symlink ({e}) and could not move back {aside} ({re})")
                    return
                print(f"  {target}: failed to restore symlink -> {old_target} ({e}); restored directory")
                return
            shutil.rmtree(aside, ignore_errors=True)
            print(f"  restored symlink {target} -> {old_target}")
        elif "backup" in prev:
            bak = Path(prev["backup"])
            if bak.is_symlink() or not bak.is_file():
                print(f"  {bak}: backup missing; cannot restore {skill_file}")
                return
            try:
                bak_bytes = bak.read_bytes()
            except OSError as e:
                print(f"  {bak}: unreadable backup ({e}); cannot restore {skill_file}")
                return
            bak_sha = prev.get("sha256")
            if isinstance(bak_sha, str) and bak_sha:
                if hashlib.sha256(bak_bytes).hexdigest() != bak_sha:
                    print(f"  {bak}: backup changed; left as is")
                    return
            raw_mode = prev.get("mode", 0o644)
            restore_mode = raw_mode if isinstance(raw_mode, int) and 0 <= raw_mode <= 0o777 else 0o644
            _write_bytes_atomic(skill_file, bak_bytes, mode=restore_mode)
            print(f"  restored {skill_file}")
    else:
        print(f"  unknown change kind {kind!r}; left as is")


def _cmd_setup_undo():
    _require_human_terminal("agy setup --undo")
    mf, data = _find_latest_undoable_manifest()
    if mf is None or data is None:
        print("nothing to undo")
        return
    applied = [a for a in (data.get("actions") or []) if isinstance(a, dict) and a.get("applied")]
    print(f"== agy setup --undo ({mf}) ==")
    print(f"created: {data.get('created', '?')} (agy rev {data.get('agy_rev', '?')})")
    for act in reversed(applied):
        print(f"  revert: {act.get('title') or act.get('id')}")
        for ch in reversed(act.get("changes") or []):
            if isinstance(ch, dict):
                print(f"    - {_describe_undo_change(ch)}")
    backups = data.get("backups") or []
    if backups:
        print("backups retained on disk for manual recovery:")
        for b in backups:
            print(f"  {b.get('backup')} (sha256 {str(b.get('sha256_before') or '')[:12]}...)")
    ans = _ask_yes_no("Revert these changes? [y/N] ", default_yes=False)
    if not ans:
        print("aborted; no changes made")
        return
    for act in reversed(applied):
        for ch in reversed(act.get("changes") or []):
            _undo_change(ch)
    _WINGMAN_SELFTEST_CACHE.clear()
    _WINGMAN_HEALTH_CACHE.clear()
    data["undone"] = _now_iso()
    _write_json_atomic(mf, data)
    print(f"marked undone: {mf}")
    if backups:
        print("backups kept at:")
        for b in backups:
            print(f"  {b.get('backup')}")


def cmd_setup(args):
    scoped = bool(getattr(args, "scoped", False))
    if getattr(args, "undo", False):
        if scoped:
            die("--scoped cannot be combined with --undo")
        return _cmd_setup_undo()
    if getattr(args, "apply", False):
        return _cmd_setup_apply(scoped=scoped)
    actions, notes, refusals = _setup_plan(scoped=scoped)
    _render_setup_plan(actions, notes, refusals)


