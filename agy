_SECRETISH_RE = re.compile(
    r"(?i)\b(key|token|secret|password|passwd|apikey|api_key|access_token|auth)=([^&\s\"']+)")


def _redact_mcp_error(text: str, spec: dict) -> str:
    """An MCP error string is server-controlled and may echo its endpoint URL or env.
    Mask the server's own env/args values and key=value secrets before printing."""
    msg = " ".join(str(text or "").split())
    vals = []
    env = spec.get("env")
    if isinstance(env, dict):
        vals.extend(str(v) for v in env.values())
    args = spec.get("args")
    if isinstance(args, list):
        vals.extend(str(a) for a in args)
    for v in sorted(set(vals), key=len, reverse=True):
        if len(v) >= 6:
            msg = msg.replace(v, "***")
    return _SECRETISH_RE.sub(lambda m: f"{m.group(1)}=***", msg)


def _doctor_extensions_mcp(daemon):
    if daemon is None:
        return [
            _doctor_check("extensions", "mcp_servers", "SKIP", "daemon not running"),
            _doctor_check("extensions", "mcp_tools", "SKIP", "daemon not running"),
        ], []
    data, kind, detail = _rpc("GetMcpServerStates", {}, daemon)
    if kind != "ok" or data is None:
        return [_doctor_check(
            "extensions", "mcp_servers", "WARN", f"GetMcpServerStates failed ({kind}): {detail}",
            fix="check Antigravity daemon")], []
    states = _unwrap(data).get("states") or []
    if not isinstance(states, list):
        states = []
    ready, err_n, other = 0, 0, 0
    err_checks = []
    all_tools = []
    for st in states:
        if not isinstance(st, dict):
            continue
        spec = st.get("spec") if isinstance(st.get("spec"), dict) else {}
        sinfo = st.get("serverInfo") if isinstance(st.get("serverInfo"), dict) else {}
        srv_name = str(spec.get("serverName") or sinfo.get("name") or "?")
        status = str(st.get("status") or "")
        if status == "MCP_SERVER_STATUS_READY":
            ready += 1
        elif status == "MCP_SERVER_STATUS_ERROR":
            err_n += 1
            err_msg = _redact_mcp_error(str(st.get("error") or ""), spec)[:120]
            plugin = str(spec.get("pluginName") or "")
            err_checks.append(_doctor_check(
                "extensions", f"mcp:{srv_name}", "WARN",
                err_msg or "MCP_SERVER_STATUS_ERROR",
                fix=(f"configure it, or disable plugin '{plugin}' if you do not use it" if plugin
                     else "check its command and env in mcp_config.json")))
        else:
            other += 1
        tools = st.get("tools") or []
        if isinstance(tools, list):
            all_tools.extend(t for t in tools if isinstance(t, dict))

    extra = f", {other} other" if other else ""
    lvl = "OK" if err_n == 0 else "INFO"
    checks = [_doctor_check(
        "extensions", "mcp_servers", lvl,
        f"{len(states)} servers ({ready} READY, {err_n} ERROR{extra})")]
    checks.extend(err_checks)
    tool_bytes = len(json.dumps(all_tools, ensure_ascii=False).encode("utf-8"))
    checks.append(_doctor_check(
        "extensions", "mcp_tools", "INFO",
        f"{len(all_tools)} tools, {_human(tool_bytes)} ({tool_bytes} bytes, ~{tool_bytes // 4} tokens)"))
    return checks, states


def _fetch_skills(daemon):
    if daemon is None:
        return None, "skip", "daemon not running"
    data, kind, detail = _rpc("GetAllSkills", {}, daemon)
    if kind != "ok" or data is None:
        return None, kind, detail
    skills = _unwrap(data).get("skills") or []
    if not isinstance(skills, list):
        skills = []
    return skills, "ok", ""


def _doctor_extensions_skills(daemon, skills_res=None) -> list:
    skills, kind, detail = skills_res if skills_res is not None else _fetch_skills(daemon)
    if kind == "skip":
        return [_doctor_check("extensions", "skills", "SKIP", "daemon not running")]
    if kind != "ok" or skills is None:
        return [_doctor_check(
            "extensions", "skills", "WARN", f"GetAllSkills failed ({kind}): {detail}",
            fix="check Antigravity daemon")]
    counts = {}
    nd_bytes = 0
    for sk in skills:
        if not isinstance(sk, dict):
            continue
        pname = str(sk.get("pluginName") or "") or "builtin"
        counts[pname] = counts.get(pname, 0) + 1
        nd_bytes += len(str(sk.get("name") or "").encode("utf-8"))
        nd_bytes += len(str(sk.get("description") or "").encode("utf-8"))
    counts_s = ", ".join(f"{k}:{v}" for k, v in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])))
    return [_doctor_check(
        "extensions", "skills", "INFO",
        f"{len(skills)} skills ({counts_s or 'none'}); name+desc {_human(nd_bytes)} ({nd_bytes} bytes, ~{nd_bytes // 4} tokens)")]


def _doctor_agents(daemon, skills_res=None) -> list:
    checks = []
    skill_src = _agy_skill_source()
    src_bytes = None
    if skill_src.is_file():
        try:
            src_bytes = skill_src.read_bytes()
        except OSError:
            src_bytes = None
    for _host, doc_name, _disp, home_fn in _SKILL_HOSTS:
        home = home_fn()
        if not home.is_dir():
            continue
        target = home / "skills" / "agy"
        state, info = _inspect_skill_target(target, src_bytes)
        if state == "refuse":
            checks.append(_doctor_check(
                "agents", doc_name, "WARN",
                info,
                fix=f"resolve manually at {target.parent} (or remove unexpected entries in {target})"))
        elif src_bytes is None:
            checks.append(_doctor_check(
                "agents", doc_name, "INFO",
                "cannot verify (agy skill source not found)"))
        elif state == "absent":
            checks.append(_doctor_check(
                "agents", doc_name, "INFO",
                "agy skill not installed (agy setup will offer it)"))
        elif state == "current":
            checks.append(_doctor_check(
                "agents", doc_name, "OK",
                "agy skill installed (current)"))
        else:
            checks.append(_doctor_check(
                "agents", doc_name, "WARN",
                "agy skill outdated",
                fix="run `agy setup --apply` in a terminal"))

    skills, sk_kind, sk_detail = skills_res if skills_res is not None else _fetch_skills(daemon)
    if sk_kind == "skip":
        checks.append(_doctor_check("agents", "antigravity", "SKIP", "daemon not running"))
    elif sk_kind != "ok" or skills is None:
        checks.append(_doctor_check(
            "agents", "antigravity", "WARN",
            f"GetAllSkills failed ({sk_kind}): {sk_detail}",
            fix="check Antigravity daemon"))
    else:
        seen = any(
            isinstance(sk, dict)
            and str(sk.get("name") or "") == "agy"
            and str(sk.get("pluginName") or "") == "wingman"
            for sk in skills
        )
        if seen:
            checks.append(_doctor_check(
                "agents", "antigravity", "OK",
                "Antigravity agents see the agy skill (via wingman)"))
        else:
            ws = _wingman_state()
            if ws["installed"]:
                installed_skill = (ws["installed_dir"] / "skills" / "agy" / "SKILL.md") if ws.get("installed_dir") else None
                in_wingman = False
                if src_bytes is not None and installed_skill is not None and installed_skill.is_file():
                    try:
                        in_wingman = installed_skill.read_bytes() == src_bytes
                    except OSError:
                        in_wingman = False
                if in_wingman and not _wingman_state()["enabled"]:
                    checks.append(_doctor_check(
                        "agents", "antigravity", "WARN",
                        "agy skill is in the wingman plugin, but wingman is disabled in Antigravity's config",
                        fix="enable the wingman plugin in Antigravity, then restart it"))
                elif in_wingman:
                    checks.append(_doctor_check(
                        "agents", "antigravity", "INFO",
                        "agy skill is in the wingman plugin but Antigravity has not loaded it yet (restart Antigravity)"))
                else:
                    checks.append(_doctor_check(
                        "agents", "antigravity", "WARN",
                        "agy skill not listed; update wingman: run `agy setup --apply` in a terminal"))
            else:
                checks.append(_doctor_check(
                    "agents", "antigravity", "INFO",
                    "wingman not installed (agy setup will offer it)"))
    return checks


