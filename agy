def _download(out: str, uri: str) -> str:
    """Veo file URIs are key-protected too: same header, still never ?key=."""
    p = Path(out).expanduser()
    p.parent.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(uri, headers={"x-goog-api-key": _api_key()})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r, open(p, "wb") as f:
            while True:
                buf = r.read(1 << 16)
                if not buf:
                    break
                f.write(buf)
    except urllib.error.HTTPError as e:
        _die_http(e, "video download")
    except OSError as e:
        die(f"video download failed: {e}", EXIT_ERR)
    return str(p)


def _save_video(out: str, op: dict) -> str:
    """NOT PROVEN E2E — generating a clip bills the owner, so this path is written to
    the documented contract, not to an observed reply. Both shapes the contract allows
    are accepted (inline base64 or a file URI); anything else prints the raw operation
    instead of guessing, so the failure is legible rather than silent."""
    for key in ("bytesBase64Encoded", "videoBytes"):
        for data in _find(op, key):
            return _write_blob(out, {"mimeType": "video/mp4", "data": data})
    for uri in _find(op, "uri"):
        if uri.startswith("http"):
            return _download(out, uri)
    die("veo finished but no video was found in the reply (shape not proven e2e):\n"
        + json.dumps(op, indent=2)[:800], EXIT_ERR)


def cmd_video(args):
    op = args.op
    if not op:
        _require_yes(args, "agy video", why="bills real money per clip (Veo, paid tier)")
        reply = _api_json(f"models/{args.model}:predictLongRunning",
                          {"instances": [{"prompt": _stdin_or(args.prompt)}],
                           "parameters": {"sampleCount": 1}})
        op = str(reply.get("name") or "")
        if not op:
            die(f"veo returned no operation name: {json.dumps(reply)[:200]}", EXIT_ERR)
    if not args.wait:
        print(op)
        print(f"agy: still rendering — poll it with:  agy video --op {op} --wait -o {args.out}",
              file=sys.stderr)
        return
    deadline = time.time() + VIDEO_WAIT
    while True:
        status = _api_json(op, timeout=30)
        if status.get("done"):
            break
        if time.time() > deadline:
            die(f"veo still running after {VIDEO_WAIT}s — resume with: agy video --op {op} --wait",
                EXIT_ERR)
        time.sleep(10)
    if status.get("error"):
        die("veo failed: " + json.dumps(status["error"])[:300], EXIT_ERR)
    print(_save_video(args.out, status))


# --------------------------------------------------------------------------- doctor

DOCTOR_LEVELS = ("OK", "INFO", "WARN", "FAIL", "SKIP")


def _doctor_check(section: str, name: str, level: str, detail: str, fix: str = "") -> dict:
    return {"section": section, "name": name, "level": level, "detail": detail, "fix": fix}


def _doctor_summary(checks: list) -> dict:
    counts = {lvl: 0 for lvl in DOCTOR_LEVELS}
    for c in checks:
        lvl = c.get("level")
        if lvl in counts:
            counts[lvl] += 1
    counts["exit"] = 1 if counts["FAIL"] > 0 else 0
    return counts


def _agy_git_rev() -> str:
    script_path = Path(__file__).resolve()
    try:
        r = _run(["git", "-C", str(script_path.parent), "rev-parse", "--short", "HEAD"], timeout=3)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return "-"


def _probe_daemon_optional():
    """Probe the live daemon without exiting on failure."""
    err_buf = io.StringIO()
    try:
        with contextlib.redirect_stderr(err_buf):
            return discover(quiet=True), ""
    except SystemExit:
        return None, " ".join(err_buf.getvalue().replace("agy:", "", 1).split())
    except (OSError, subprocess.SubprocessError) as e:
        return None, str(e)


def _doctor_runtime() -> list:
    v = sys.version_info
    py_ver = f"{v[0]}.{v[1]}.{v[2]}"
    script_path = Path(__file__).resolve()
    return [
        _doctor_check("runtime", "python", "OK", py_ver),
        _doctor_check("runtime", "agy", "INFO", f"{script_path} (rev {_agy_git_rev()})"),
    ]


def _doctor_app():
    checks = []
    if APP_LANGUAGE_SERVER.is_file():
        checks.append(_doctor_check("app", "language_server", "OK", str(APP_LANGUAGE_SERVER)))
    else:
        checks.append(_doctor_check(
            "app", "language_server", "WARN", f"missing at {APP_LANGUAGE_SERVER}",
            fix="install Antigravity.app in /Applications"))

    has_ls_fallback = (
        sys.platform == "darwin"
        and APP_LANGUAGE_SERVER.is_file()
        and os.access(APP_LANGUAGE_SERVER, os.X_OK)
    )
    if AGENTAPI.is_file() and os.access(AGENTAPI, os.X_OK):
        checks.append(_doctor_check("app", "agentapi", "OK", str(AGENTAPI)))
    elif AGENTAPI.exists():
        checks.append(_doctor_check(
            "app", "agentapi", "WARN", f"not executable: {AGENTAPI}",
            fix=f"chmod +x {AGENTAPI}"))
    elif has_ls_fallback:
        checks.append(_doctor_check(
            "app", "agentapi", "INFO", f"missing at {AGENTAPI} (using language_server fallback)"))
    else:
        checks.append(_doctor_check(
            "app", "agentapi", "FAIL", f"missing at {AGENTAPI}",
            fix="open or reinstall Antigravity.app"))

    daemon, daemon_err = _probe_daemon_optional()

    if daemon is not None:
        checks.append(_doctor_check("app", "daemon", "OK", f"pid {daemon.pid}, v{daemon.version}"))
    else:
        checks.append(_doctor_check(
            "app", "daemon", "FAIL", daemon_err or "Antigravity daemon not running",
            fix="open the Antigravity app"))

    if daemon is None:
        checks.append(_doctor_check("app", "rpc_canary", "SKIP", "daemon not running"))
    else:
        t0 = time.monotonic()
        avail, kind, detail = _rpc("GetAvailableModels", {}, daemon)
        ms = max(0, int(round((time.monotonic() - t0) * 1000)))
        if kind == "ok" and avail is not None:
            checks.append(_doctor_check("app", "rpc_canary", "OK", f"GetAvailableModels ok ({ms} ms)"))
        else:
            checks.append(_doctor_check(
                "app", "rpc_canary", "FAIL", f"GetAvailableModels failed ({kind}): {detail}",
                fix="restart the Antigravity app and retry"))
    return checks, daemon


def _doctor_models(daemon) -> list:
    if daemon is None:
        return [
            _doctor_check("models", "catalog", "SKIP", "daemon not running"),
            _doctor_check("models", "quota", "SKIP", "daemon not running"),
        ]
    checks = []
    cat, why = _catalog(daemon)
    if cat is None:
        checks.append(_doctor_check(
            "models", "catalog", "FAIL", f"unreadable: {why}",
            fix="run `agy models --raw` to inspect daemon catalog RPCs"))
    else:
        total = len(cat["models"])
        enabled = sum(1 for m in cat["models"].values() if not m["disabled"])
        picker = sum(1 for m in cat["models"].values() if m["picker"] and not m["disabled"])
        checks.append(_doctor_check(
            "models", "catalog", "OK", f"{total} models ({picker} in picker, {enabled} enabled)"))

    qdata, qkind, qdet = _rpc("RetrieveUserQuotaSummary", {}, daemon)
    if qkind != "ok" or qdata is None:
        checks.append(_doctor_check(
            "models", "quota", "WARN", f"unreadable ({qkind}): {qdet}",
            fix="run `agy quota` to inspect"))
        return checks

    groups = _unwrap(qdata).get("groups") or []
    interpreted = []
    if isinstance(groups, list):
        for g in groups:
            if not isinstance(g, dict):
                continue
            for b in g.get("buckets") or []:
                if not isinstance(b, dict):
                    continue
                group = str(g.get("displayName") or "").split(" — ")[0].strip()
                bucket = str(b.get("displayName") or b.get("bucketId") or "?")
                label = f"{group}: {bucket}" if group else bucket
                interpreted.append((label, _interpret_bucket(b)))
    if not interpreted:
        checks.append(_doctor_check("models", "quota", "INFO", "no quota buckets reported"))
    else:
        exhausted = [lbl for lbl, info in interpreted if info["exhausted"]]
        if exhausted:
            checks.append(_doctor_check(
                "models", "quota", "WARN", f"exhausted: {', '.join(exhausted)}",
                fix="wait for quota reset (see `agy quota`)"))
        else:
            low_lbl, low_info = min(interpreted, key=lambda pair: pair[1]["fraction"])
            pct = low_info["fraction"] * 100
            eta = low_info["eta"]
            reset_part = f", resets in {eta}" if eta not in ("-", "now") else (
                ", resets now" if eta == "now" else "")
            checks.append(_doctor_check(
                "models", "quota", "INFO", f"lowest remaining {pct:.1f}% ({low_lbl}{reset_part})"))
    return checks


