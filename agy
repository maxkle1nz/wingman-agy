# --------------------------------------------------------------------------- discovery

@dataclass
class Daemon:
    pid: int
    port: int
    token: str
    version: str


def _run(cmd, timeout=10, env=None, input=None):
    kwargs = {"capture_output": True, "text": True, "timeout": timeout, "env": env}
    if input is not None:
        kwargs["input"] = input
    return subprocess.run(cmd, **kwargs)


def _ps_command(pid: int) -> str:
    r = _run(["ps", "-p", str(pid), "-o", "command="])
    return r.stdout.strip()


def _flag_value(cmdline: str, flag: str) -> str:
    parts = cmdline.split()
    for i, p in enumerate(parts):
        if p == flag and i + 1 < len(parts):
            return parts[i + 1]
        if p.startswith(flag + "="):
            return p.split("=", 1)[1]
    return ""


def _listen_ports(pid: int) -> list:
    r = _run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-a", "-p", str(pid)])
    ports = []
    for line in r.stdout.splitlines()[1:]:
        m = re.search(r":(\d+)\s+\(LISTEN\)", line)
        if m:
            p = int(m.group(1))
            if p not in ports:
                ports.append(p)
    return ports


def _probe_id() -> str:
    """A real conversation id makes the probe response unambiguous."""
    conv_dir = _agy_home() / "conversations"
    if conv_dir.is_dir():
        for f in sorted(conv_dir.glob("*.db")):
            return f.stem
    return DUMMY_CONV


def _agentapi_env(port: int, token: str, extra: dict = None) -> dict:
    env = dict(os.environ)
    env["ANTIGRAVITY_LS_ADDRESS"] = f"127.0.0.1:{port}"
    env["ANTIGRAVITY_CSRF_TOKEN"] = token
    if extra:
        env.update(extra)
    return env


def _classify(raw: str) -> str:
    """Classify an agentapi reply: ok | auth | transport."""
    if not raw.strip():
        # Empty output proves nothing — a port that accepts and says nothing
        # must not pass the discovery probe.
        return "transport"
    try:
        parsed = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        parsed = None
    if parsed is not None:
        # Valid JSON of any shape means transport+auth worked; only a dict
        # can carry a classifiable "error" field.
        err = str(parsed.get("error") or "") if isinstance(parsed, dict) else ""
    else:
        err = raw
    low = err.lower()
    if not err:
        return "ok"
    if "unauthenticated" in low or "csrf" in low:
        return "auth"
    if "unavailable" in low or "preface" in low or "connection" in low or "refused" in low:
        return "transport"
    # Any app-level error (e.g. unknown conversation) means transport+auth worked.
    return "ok"


def _agentapi_command() -> list:
    """Prefer Google's wrapper; newer macOS installs may only ship its subcommand."""
    if AGENTAPI.is_file() and os.access(AGENTAPI, os.X_OK):
        return [str(AGENTAPI)]
    if sys.platform == "darwin" and APP_LANGUAGE_SERVER.is_file() and os.access(APP_LANGUAGE_SERVER, os.X_OK):
        return [str(APP_LANGUAGE_SERVER), "agentapi"]
    die(f"agentapi not found at {AGENTAPI}; no executable Antigravity app fallback found",
        EXIT_NO_DAEMON)


def _agentapi(port: int, token: str, args: list, timeout=CALL_TIMEOUT, extra_env=None):
    command = _agentapi_command()
    try:
        r = _run(command + args, timeout=timeout, env=_agentapi_env(port, token, extra_env))
    except subprocess.TimeoutExpired:
        return None, "transport", f"agentapi timed out after {timeout}s (wrong port or daemon busy)"
    # Classify on stdout when present: stderr warnings alongside valid JSON must
    # not turn a success into a bogus "transport" failure.
    out, errout = r.stdout or "", r.stderr or ""
    raw = out if out.strip() else errout
    return raw, _classify(raw), None


def discover(quiet=False) -> Daemon:
    """Find the live daemon: pid -> csrf token (from process args) -> ports -> proven gRPC port.

    Port and token are extracted from the SAME process snapshot, so they can never
    be mismatched across a daemon restart (askGOD required_change #2).
    """
    forced_port, forced_token = os.environ.get("AGY_BRIDGE_PORT"), os.environ.get("AGY_BRIDGE_TOKEN")
    if forced_port and forced_token:
        return Daemon(pid=0, port=int(forced_port), token=forced_token, version="forced")

    # On macOS, pgrep excludes ancestors of the calling process unless -a is passed,
    # which hid the live daemon when agy ran inside an Antigravity agent shell.
    pgrep_cmd = ["pgrep", "-a", "-f", "language_server"] if sys.platform == "darwin" else ["pgrep", "-f", "language_server"]
    r = _run(pgrep_cmd)
    pids = [int(p) for p in r.stdout.split()]
    candidates = []
    for pid in pids:
        cmd = _ps_command(pid)
        token = _flag_value(cmd, "--csrf_token")
        if not token:
            continue
        score = 0
        score += 2 if "--standalone" in cmd else 0
        score += 2 if _flag_value(cmd, "--subclient_type") == "hub" else 0
        score += 1 if _flag_value(cmd, "--app_data_dir") == "antigravity" else 0
        version = _flag_value(cmd, "--override_ide_version") or "?"
        candidates.append((score, pid, token, version))
    if not candidates:
        die("Antigravity daemon not running (no language_server with --csrf_token found).\n"
            "Open the Antigravity app (hub) and retry.", EXIT_NO_DAEMON)

    candidates.sort(reverse=True)
    probe = _probe_id()
    transport_failures = []
    for _score, pid, token, version in candidates:
        for port in _listen_ports(pid):
            raw, kind, err = _agentapi(port, token, ["get-conversation-metadata", probe], timeout=10)
            if kind == "ok":
                return Daemon(pid=pid, port=port, token=token, version=version)
            if kind == "auth":
                # Token came from this very process snapshot; a rejection means the
                # daemon restarted between ps and the call. Retry once from scratch.
                die("Daemon rejected a token read from its own live process args — it likely\n"
                    "restarted mid-call. Re-run the command.", EXIT_AUTH)
            transport_failures.append(f"127.0.0.1:{port}: {err or 'no gRPC on this port'}")
    die("Antigravity daemon is running (pid {}) but no listening port accepted gRPC:\n  {}\n"
        "The daemon may be mid-restart; retry in a few seconds.".format(
            candidates[0][1], "\n  ".join(transport_failures) or "no listening ports"),
        EXIT_NO_DAEMON)


# --------------------------------------------------------------------------- helpers

def die(msg: str, code=EXIT_ERR):
    print(f"agy: {msg}", file=sys.stderr)
    sys.exit(code)


def _print_json(raw: str):
    try:
        print(json.dumps(json.loads(raw), indent=2, ensure_ascii=False))
    except (json.JSONDecodeError, ValueError):
        print(raw.rstrip())


def _short_err(raw: str) -> str:
    try:
        j = json.loads(raw)
        if isinstance(j, dict):
            return str(j.get("error") or "")[:200] or raw[:200]
    except (json.JSONDecodeError, ValueError):
        pass
    return (raw or "no output")[:200]


def _die_on_app_error(raw: str):
    """new/send: an app-level {"error": ...} reply must fail the process —
    a caller trusting the exit code must never believe an errored dispatch."""
    try:
        j = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        return
    if isinstance(j, dict) and j.get("error"):
        die(str(j["error"])[:300], EXIT_ERR)


def _exit_code_for(kind: str) -> int:
    return {"transport": EXIT_NO_DAEMON, "auth": EXIT_AUTH}.get(kind, EXIT_ERR)


def _agy_home() -> Path:
    """Base Antigravity directory; respects both patched AGY_HOME and AGY_BRIDGE_HOME env."""
    if AGY_HOME != _INIT_AGY_HOME:
        return AGY_HOME
    env_home = os.environ.get("AGY_BRIDGE_HOME")
    return Path(env_home).expanduser() if env_home else AGY_HOME


def _conversations() -> list:
    """All conversations on disk: (id, format, path). Tolerates legacy .pb-only entries."""
    conv_dir = _agy_home() / "conversations"
    out = []
    if conv_dir.is_dir():
        for f in sorted(conv_dir.iterdir()):
            if f.suffix == ".db":
                out.append((f.stem, "db", f))
            elif f.suffix == ".pb":
                out.append((f.stem, "pb", f))
    return out


_UUID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    re.IGNORECASE,
)


def _is_valid_uuid(conv_id: str) -> bool:
    return isinstance(conv_id, str) and bool(_UUID_RE.match(conv_id))


def _require_uuid(conv_id: str) -> str:
    if not _is_valid_uuid(conv_id):
        raise ValueError(f"invalid conversation UUID: {conv_id!r}")
    return conv_id


def _brain_dir(conv_id: str) -> Path:
    return _agy_home() / "brain" / _require_uuid(conv_id)


def _presence_lock(conv_id: str) -> Path:
    return _agy_home() / "presence" / f"{_require_uuid(conv_id)}.lock"


def _transcript_path(conv_id: str, full=False) -> Path:
    name = "transcript_full.jsonl" if full else "transcript.jsonl"
    return _brain_dir(conv_id) / ".system_generated" / "logs" / name


def _artifacts(conv_id: str) -> list:
    """Brain artifacts with their sidecar metadata: (name, summary, updated_at, user_facing)."""
    b = _brain_dir(conv_id)
    arts = []
    if not b.is_dir():
        return arts
    for f in sorted(b.iterdir()):
        if f.is_file() and not f.name.endswith(".metadata.json") and not f.name.startswith("."):
            meta = {}
            mf = b / (f.name + ".metadata.json")
            if mf.exists():
                try:
                    meta = json.loads(mf.read_text())
                except (json.JSONDecodeError, OSError):
                    meta = {}
            arts.append((f.name, meta.get("summary", ""), meta.get("updatedAt", ""),
                         meta.get("userFacing")))
    return arts


def _steps_ro(db_path: Path, limit=10) -> list:
    """Last steps from the SQLite ledger, read-only. Enum ints are shown raw:
    the int->name mapping of CORTEX_STEP_TYPE/STATUS is not public — we do not guess."""
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2)
        try:
            rows = con.execute(
                "SELECT idx, step_type, status FROM steps ORDER BY idx DESC LIMIT ?", (limit,)
            ).fetchall()
            total = con.execute("SELECT COUNT(*) FROM steps").fetchone()[0]
        finally:
            con.close()
        return [dict(idx=r[0], step_type=r[1], status=r[2]) for r in reversed(rows)], total
    except sqlite3.Error as e:
        return [], f"(sqlite: {e})"


def _find(obj, key):
    """Yield every value stored under `key` anywhere in a nested JSON structure."""
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == key and isinstance(v, str):
                yield v
            else:
                yield from _find(v, key)
    elif isinstance(obj, list):
        for it in obj:
            yield from _find(it, key)


def _uri_to_path(uri: str) -> str:
    return uri[7:] if uri.startswith("file://") else uri


def _project_for_workspace(d: Daemon, workspace: str):
    """Resolve the Antigravity projectId for a workspace path by reading the
    metadata of existing conversations (projectId is a per-workspace UUID the
    app assigns; there is no plaintext registry). Returns the id or None."""
    target = os.path.realpath(workspace)
    for cid, fmt, _path in _conversations():
        if fmt != "db":
            continue
        raw, kind, _err = _agentapi(d.port, d.token, ["get-conversation-metadata", cid], timeout=15)
        if kind != "ok":
            continue
        try:
            meta = json.loads(raw)
        except (json.JSONDecodeError, ValueError):
            continue
        pids = list(_find(meta, "projectId"))
        if not pids:
            continue
        paths = {os.path.realpath(_uri_to_path(u))
                 for key in ("workspaceFolderAbsoluteUri", "gitRootAbsoluteUri")
                 for u in _find(meta, key)}
        if target in paths:
            return pids[0]
    return None


def _resolve_conv(prefix: str) -> str:
    ids = [c[0] for c in _conversations()]
    exact = [i for i in ids if i == prefix]
    if exact:
        return exact[0]
    matches = [i for i in ids if i.startswith(prefix)]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f"no conversation matches '{prefix}' (see: agy ls)")
    die(f"'{prefix}' is ambiguous: {', '.join(m[:12] for m in matches)}")


# --------------------------------------------------------------------------- commands

def cmd_status(_args):
    d = discover()
    convs = _conversations()
    n_db = sum(1 for c in convs if c[1] == "db")
    n_pb = sum(1 for c in convs if c[1] == "pb")
    print(f"daemon      : up (pid {d.pid}, v{d.version})")
    print(f"grpc port   : 127.0.0.1:{d.port} (proven with get-conversation-metadata)")
    print("csrf token  : present (read from process args; never printed or stored)")
    print(f"agentapi    : {' '.join(_agentapi_command())}")
    print(f"conversations: {n_db} readable (.db) + {n_pb} legacy (.pb)")
    try:
        with urllib.request.urlopen("http://127.0.0.1:1338/api/health", timeout=2) as r:
            ok = r.status == 200
        print(f"m1nd :1338  : {'up (shared memory bridge active)' if ok else 'unexpected status'}")
    except OSError:
        print("m1nd :1338  : down (memory bridge inactive — Claude and AGY lose shared recall)")
    # Presence only, exactly like the CSRF line: knowing the lane is armed must never
    # cost the value of the credential.
    print("gemini api  : key {} ({})".format(
        "present" if _api_key_present() else "MISSING (ask/img/tts/embed/video are dead)",
        API_BASE))


def cmd_ls(_args):
    convs = _conversations()
    if not convs:
        print("no conversations found")
        return
    print(f"{'ID':<14} {'FMT':<4} {'STEPS':>6} {'MODIFIED':<17} TITLE")
    for cid, fmt, path in convs:
        mtime = time.strftime("%Y-%m-%d %H:%M", time.localtime(path.stat().st_mtime))
        if fmt == "pb":
            print(f"{cid[:12]:<14} {'pb':<4} {'-':>6} {mtime:<17} (legacy protobuf format, not readable)")
            continue
        _steps, total = _steps_ro(path, limit=1)
        arts = _artifacts(cid)
        title = ""
        for _name, summary, _up, user_facing in arts:
            if summary:
                title = summary
                if user_facing:
                    break
        if not title and arts:
            title = arts[0][0]
        total_s = str(total) if isinstance(total, int) else "?"
        print(f"{cid[:12]:<14} {'db':<4} {total_s:>6} {mtime:<17} {title[:60]}")


def cmd_show(args):
    cid = _resolve_conv(args.conversation)
    d = discover()
    raw, kind, err = _agentapi(d.port, d.token, ["get-conversation-metadata", cid])
    daemon_ok = kind == "ok" and not err
    print(f"== metadata ({cid}) ==")
    if daemon_ok:
        _print_json(raw)
    else:
        print(f"  daemon call failed ({kind}): {err or _short_err(raw)}")
    # What ACTUALLY ran, from the daemon — the requested model is not evidence.
    ran, rerr = _generator_models(d, cid)
    print("\n== models that ran ==")
    if rerr:
        print(f"  unavailable ({rerr})")
    elif not ran:
        print("  none reported yet")
    else:
        counts = {}
        for r in ran:
            counts[r] = counts.get(r, 0) + 1
        for (response_model, display), n in counts.items():
            print(f"  {display or '?'} ({response_model})  x{n}")
    arts = _artifacts(cid)
    print(f"\n== brain artifacts ({len(arts)}) ==  [{_brain_dir(cid)}]")
    for name, summary, updated, _uf in arts:
        line = f"  {name}"
        if updated:
            line += f"  (updated {updated})"
        print(line)
        if summary:
            print(f"      {summary[:100]}")
    db = _agy_home() / "conversations" / f"{cid}.db"
    if db.exists():
        steps, total = _steps_ro(db, limit=args.steps)
        print(f"\n== last steps ({len(steps)} of {total}; raw enum ints — mapping not public) ==")
        for s in steps:
            print(f"  idx {s['idx']:>4}  type={s['step_type']:<4} status={s['status']}")
    tasks_dir = _brain_dir(cid) / ".system_generated" / "tasks"
    if tasks_dir.is_dir():
        logs = list(tasks_dir.glob("*.log"))
        if logs:
            print(f"\n== background task logs ==  {len(logs)} file(s) in {tasks_dir}")
    tp = _transcript_path(cid)
    if tp.exists():
        print(f"\ntranscript: {tp}  (agy tail {cid[:8]})")
    if not daemon_ok:
        sys.exit(_exit_code_for(kind))


def _render_transcript_line(line: str) -> str:
    try:
        j = json.loads(line)
    except (json.JSONDecodeError, ValueError):
        return line.rstrip()
    idx = j.get("step_index", "?")
    typ = str(j.get("type", "?"))
    status = str(j.get("status", ""))
    src = str(j.get("source", ""))
    content = j.get("content", "")
    if isinstance(content, (dict, list)):
        content = json.dumps(content, ensure_ascii=False)
    content = " ".join(str(content).split())
    return f"[{idx:>4}] {typ:<22} {status:<12} {src:<8} {content[:140]}"


def cmd_tail(args):
    cid = _resolve_conv(args.conversation)
    tp = _transcript_path(cid, full=args.full)
    if not tp.exists():
        die(f"no transcript at {tp}")
    lines = tp.read_text(errors="replace").splitlines()
    for line in lines[-args.lines:]:
        print(_render_transcript_line(line))
    if not args.follow:
        return
    pos = tp.stat().st_size
    try:
        while True:
            time.sleep(1)
            size = tp.stat().st_size
            if size < pos:
                # File truncated/rotated: restart from the top instead of
                # silently following nothing.
                print("-- transcript truncated; re-reading --", file=sys.stderr)
                pos = 0
            if size > pos:
                with open(tp, errors="replace") as f:
                    f.seek(pos)
                    for line in f.read().splitlines():
                        print(_render_transcript_line(line))
                pos = size
    except KeyboardInterrupt:
        pass


