def _doctor_m1nd(daemon, mcp_states: list) -> list:
    cfg_entry = None
    try:
        cfg = json.loads(_mcp_config_path().read_text(encoding="utf-8"))
        servers = cfg.get("mcpServers") if isinstance(cfg, dict) else None
        if isinstance(servers, dict):
            for k, v in servers.items():
                if str(k).lower() == "m1nd" and isinstance(v, dict):
                    cfg_entry = v
                    break
    except (OSError, ValueError):
        pass

    live_state = None
    for st in mcp_states:
        if not isinstance(st, dict):
            continue
        spec = st.get("spec") if isinstance(st.get("spec"), dict) else {}
        sinfo = st.get("serverInfo") if isinstance(st.get("serverInfo"), dict) else {}
        sname = str(spec.get("serverName") or sinfo.get("name") or "")
        if sname.lower() == "m1nd":
            live_state = st
            break

    if cfg_entry is None and live_state is None:
        return []

    checks = []
    if daemon is None:
        checks.append(_doctor_check("m1nd", "server", "SKIP", "daemon not running"))
    elif live_state is None:
        checks.append(_doctor_check(
            "m1nd", "server", "WARN", "configured in mcp_config.json but absent from daemon MCP states",
            fix="restart Antigravity or check m1nd docs/AGENT-AUTONOMY.md"))
    else:
        status = str(live_state.get("status") or "")
        if status == "MCP_SERVER_STATUS_READY":
            checks.append(_doctor_check("m1nd", "server", "OK", status))
        else:
            checks.append(_doctor_check(
                "m1nd", "server", "WARN", status or "not ready",
                fix="check m1nd server configuration (see m1nd docs/AGENT-AUTONOMY.md)"))

    env = {}
    if isinstance((cfg_entry or {}).get("env"), dict):
        env.update(cfg_entry["env"])
    live_spec = (live_state or {}).get("spec") if isinstance((live_state or {}).get("spec"), dict) else {}
    if isinstance(live_spec.get("env"), dict):
        env.update(live_spec["env"])

    req_keys = ("M1ND_WORKSPACE_ROOT", "M1ND_RUNTIME_DIR")
    missing = [k for k in req_keys if not str(env.get(k) or "").strip()]
    if not missing:
        checks.append(_doctor_check("m1nd", "env", "OK", "defines M1ND_WORKSPACE_ROOT and M1ND_RUNTIME_DIR"))
    else:
        checks.append(_doctor_check(
            "m1nd", "env", "WARN", f"missing env key(s): {', '.join(missing)}",
            fix="define M1ND_WORKSPACE_ROOT and M1ND_RUNTIME_DIR (see m1nd docs/AGENT-AUTONOMY.md)"))

    rt_val = str(env.get("M1ND_RUNTIME_DIR") or "").strip()
    if not rt_val:
        checks.append(_doctor_check(
            "m1nd", "runtime_dir", "WARN", "M1ND_RUNTIME_DIR not defined",
            fix="create a 0700 directory for M1ND_RUNTIME_DIR (see m1nd docs/AGENT-AUTONOMY.md)"))
    else:
        try:
            st = Path(rt_val).expanduser().stat()
        except OSError:
            checks.append(_doctor_check(
                "m1nd", "runtime_dir", "WARN", "runtime dir does not exist",
                fix="create M1ND_RUNTIME_DIR with chmod 0700 (see m1nd docs/AGENT-AUTONOMY.md)"))
        else:
            mode = st.st_mode & 0o777
            if not stat.S_ISDIR(st.st_mode):
                checks.append(_doctor_check(
                    "m1nd", "runtime_dir", "WARN", "runtime dir path is not a directory",
                    fix="replace with a mode 0700 directory (see m1nd docs/AGENT-AUTONOMY.md)"))
            elif mode != 0o700:
                checks.append(_doctor_check(
                    "m1nd", "runtime_dir", "WARN", f"mode {oct(mode)} (expected 0o700)",
                    fix="chmod 0700 on M1ND_RUNTIME_DIR (see m1nd docs/AGENT-AUTONOMY.md)"))
            else:
                checks.append(_doctor_check("m1nd", "runtime_dir", "OK", "exists with mode 0700"))
    return checks


