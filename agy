def _parse_older_than(spec: str) -> timedelta:
    m = re.match(r"^\s*(\d+(?:\.\d+)?)\s*([hdHD])\s*$", str(spec or ""))
    if not m:
        die(f"invalid --older-than '{spec}' (expected e.g. 12h or 3d)", EXIT_ERR)
    val = float(m.group(1))
    unit = m.group(2).lower()
    return timedelta(days=val) if unit == "d" else timedelta(hours=val)


def _parse_iso(ts: str):
    if not ts:
        return None
    s = str(ts).strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    s = re.sub(
        r"\.(\d+)(?=(?:[+-]\d{2}:?\d{2})?$)",
        lambda m: "." + (m.group(1) + "000000")[:6],
        s,
    )
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    return dt if dt.tzinfo is not None else dt.replace(tzinfo=timezone.utc)


def _format_age(secs: int) -> str:
    days, rem = divmod(max(0, secs), 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {mins}m"
    return f"{mins}m"


def _dir_bytes(path: Path) -> int:
    if not path.exists() or path.is_symlink():
        return 0
    if path.is_file():
        return path.lstat().st_size
    total = 0
    for p in path.rglob("*"):
        if not p.is_symlink() and p.is_file():
            total += p.lstat().st_size
    return total


def _is_idle_status(status: str) -> bool:
    return status in ("CASCADE_RUN_STATUS_IDLE", "IDLE")


def _is_active_status(status: str) -> bool:
    return status in (
        "CASCADE_RUN_STATUS_RUNNING", "RUNNING",
        "CASCADE_RUN_STATUS_BUSY", "BUSY",
        "CASCADE_RUN_STATUS_CANCELING", "CANCELING",
    )


def _daemon_trajectories(daemon: Daemon):
    """Merge GetAllCascadeTrajectories and SearchConversations: (records, kind, detail, flags)."""
    traj_data, tkind, tdet = _rpc("GetAllCascadeTrajectories", {}, daemon)
    search_data, skind, sdet = _rpc("SearchConversations", {"query": "", "limit": 200}, daemon)
    if traj_data is None and search_data is None:
        return None, tkind, tdet, (False, False)
    records = {}
    if traj_data is not None:
        summaries = _unwrap(traj_data).get("trajectorySummaries") or {}
        if isinstance(summaries, dict):
            for cid, info in summaries.items():
                if not isinstance(info, dict):
                    continue
                ann = info.get("annotations") if isinstance(info.get("annotations"), dict) else {}
                tm = info.get("trajectoryMetadata") if isinstance(info.get("trajectoryMetadata"), dict) else {}
                depth = tm.get("nestingDepth")
                is_subagent = (isinstance(depth, int) and depth >= 1) or bool(
                    tm.get("subagentSpec") or info.get("subagentSpec")
                )
                records[str(cid)] = {
                    "status": str(info.get("status") or ""),
                    "lastModifiedTime": str(info.get("lastModifiedTime") or ""),
                    "title": str(ann.get("title") or info.get("summary") or ""),
                    "parent": str(tm.get("parentConversationId") or info.get("parentConversationId") or ""),
                    "depth": depth if isinstance(depth, int) else 0,
                    "is_subagent": is_subagent,
                    "starred": bool(ann.get("starred") or info.get("starred")),
                    "pinned": bool(ann.get("pinned") or info.get("pinned")),
                }
    if search_data is not None:
        results = _unwrap(search_data).get("results") or []
        if isinstance(results, list):
            for item in results:
                if not isinstance(item, dict) or not item.get("cascadeId"):
                    continue
                cid = str(item["cascadeId"])
                item_ann = item.get("annotations") if isinstance(item.get("annotations"), dict) else {}
                item_tm = item.get("trajectoryMetadata") if isinstance(item.get("trajectoryMetadata"), dict) else {}
                item_starred = bool(item_ann.get("starred") or item.get("starred"))
                item_pinned = bool(item_ann.get("pinned") or item.get("pinned"))
                depth = item.get("nestingDepth") if isinstance(item.get("nestingDepth"), int) else item_tm.get("nestingDepth")
                item_subagent = (isinstance(depth, int) and depth >= 1) or bool(
                    item_tm.get("subagentSpec") or item.get("subagentSpec")
                )
                rec = records.get(cid)
                if rec is None:
                    records[cid] = {
                        "status": str(item.get("status") or ""),
                        "lastModifiedTime": str(item.get("lastModifiedTime") or ""),
                        "title": str(item.get("title") or item_ann.get("title") or ""),
                        "parent": str(item_tm.get("parentConversationId") or item.get("parentConversationId") or ""),
                        "depth": depth if isinstance(depth, int) else 0,
                        "is_subagent": item_subagent,
                        "starred": item_starred,
                        "pinned": item_pinned,
                    }
                else:
                    if not rec["status"] and item.get("status"):
                        rec["status"] = str(item["status"])
                    if not rec["lastModifiedTime"] and item.get("lastModifiedTime"):
                        rec["lastModifiedTime"] = str(item["lastModifiedTime"])
                    if not rec["title"] and (item.get("title") or item_ann.get("title")):
                        rec["title"] = str(item.get("title") or item_ann.get("title"))
                    if not rec["parent"] and (item_tm.get("parentConversationId") or item.get("parentConversationId")):
                        rec["parent"] = str(item_tm.get("parentConversationId") or item.get("parentConversationId"))
                    if item_subagent:
                        rec["is_subagent"] = True
                    if item_starred:
                        rec["starred"] = True
                    if item_pinned:
                        rec["pinned"] = True
    return records, "ok", "", (traj_data is not None, search_data is not None)


def _sort_children_first(candidates: list, records: dict):
    """Topological order placing subagent children before their parents."""
    cand_by_id = {c["id"]: c for c in candidates}
    children_of = {cid: [] for cid in cand_by_id}
    for cid in cand_by_id:
        parent = (records.get(cid) or {}).get("parent") or ""
        if parent in cand_by_id and parent != cid:
            children_of[parent].append(cid)
    ordered, seen, visiting = [], set(), set()

    def visit(cid):
        if cid in seen or cid in visiting:
            return
        visiting.add(cid)
        for ch in sorted(children_of[cid], key=lambda x: (-cand_by_id[x]["depth"], x)):
            visit(ch)
        visiting.remove(cid)
        seen.add(cid)
        ordered.append(cand_by_id[cid])

    for cid in sorted(cand_by_id, key=lambda x: (-cand_by_id[x]["depth"], x)):
        visit(cid)
    return ordered, children_of


def _revalidate_gc_candidate(daemon: Daemon, cid: str):
    """Re-check live status and starred/pinned state immediately before DeleteCascadeTrajectory."""
    tdata, tkind, tdet = _rpc("GetAllCascadeTrajectories", {}, daemon)
    if tkind != "ok" or tdata is None:
        return False, f"re-check GetAllCascadeTrajectories failed ({tkind}): {tdet}"
    summaries = _unwrap(tdata).get("trajectorySummaries") or {}
    if not isinstance(summaries, dict) or cid not in summaries or not isinstance(summaries[cid], dict):
        return False, f"{cid} missing from GetAllCascadeTrajectories on re-check"
    info = summaries[cid]
    ann = info.get("annotations") if isinstance(info.get("annotations"), dict) else {}
    if ann.get("starred") or ann.get("pinned") or info.get("starred") or info.get("pinned"):
        return False, f"{cid} is now starred/pinned"
    status = str(info.get("status") or "")
    if not _is_idle_status(status):
        return False, f"{cid} status changed to {status or 'unknown'}"
    return True, ""


def _confirm_trajectory_gone(daemon: Daemon, cid: str, had_traj: bool, had_search: bool,
                             timeout: float = 20.0):
    if had_traj:
        t2, tkind, tdet = _rpc("GetAllCascadeTrajectories", {}, daemon)
        if tkind != "ok" or t2 is None:
            return False, f"re-list GetAllCascadeTrajectories failed ({tkind}): {tdet}"
        summaries = _unwrap(t2).get("trajectorySummaries") or {}
        if isinstance(summaries, dict) and cid in summaries:
            return False, f"{cid} still present in GetAllCascadeTrajectories"
    # SearchConversations is an eventually consistent index; poll until the id drops or timeout.
    deadline = time.monotonic() + max(0.0, float(timeout))
    while True:
        s2, skind, sdet = _rpc("SearchConversations", {"query": "", "limit": 200}, daemon)
        if skind == "ok" and s2 is not None:
            s_ids = {str(x.get("cascadeId") or "")
                     for x in (_unwrap(s2).get("results") or []) if isinstance(x, dict)}
            if cid not in s_ids:
                return True, ""
            left = deadline - time.monotonic()
            if left <= 0:
                return False, f"{cid} still present in SearchConversations"
            time.sleep(min(1.0, left))
            continue
        if had_search:
            return False, f"re-list SearchConversations failed ({skind}): {sdet}"
        if not had_traj:
            return False, f"re-list failed ({skind}): {sdet}"
        return True, ""


def _mark_ledger_deleted(cid: str):
    def _mutate(rows):
        changed = False
        for e in rows:
            if e.get("conversationId") == cid and not e.get("deleted"):
                e["deleted"] = True
                changed = True
        return changed
    _rewrite_ledger_under_lock(_mutate)


def cmd_gc(args):
    cutoff_delta = _parse_older_than(args.older_than)
    entries = _read_ledger()
    ledger_map = {}
    for e in entries:
        cid = str(e.get("conversationId") or "")
        if cid and not e.get("deleted"):
            ledger_map[cid] = e
    if not ledger_map:
        print("no active ledger conversations eligible for gc")
        return

    d = discover()
    records, kind, detail, (had_traj, had_search) = _daemon_trajectories(d)
    if records is None:
        die(f"cannot read conversation statuses from daemon ({kind}): {detail}", _exit_code_for(kind))

    if had_traj and had_search:
        for e in _reconcile_ledger(entries, records):
            cid = str(e.get("conversationId") or "")
            ledger_map.pop(cid, None)
            print(f"reconciled {cid} ({e.get('title') or 'untitled'})")

    # Subagents (e.g. `image-generator`) are spawned by an agent, not by agy, so they never
    # get a ledger line. They belong to agy when an ancestor is in the ledger: adopt them
    # here, or deleting the parent would orphan them for good. The status and age filters
    # below still apply to them, exactly as to ledger ids.
    for rid, rec in records.items():
        if rid in ledger_map or not _is_valid_uuid(rid) or not rec.get("is_subagent"):
            continue
        seen, parent = {rid}, rec.get("parent") or ""
        while parent and parent not in seen and parent not in ledger_map:
            prec = records.get(parent)
            if not prec or not prec.get("is_subagent"):
                parent = ""
                break
            seen.add(parent)
            parent = prec.get("parent") or ""
        if parent in ledger_map:
            ledger_map[rid] = {"conversationId": rid, "title": rec.get("title") or "",
                               "via_parent": parent}

    now = datetime.now(timezone.utc)
    eligible = {}
    skipped = []
    too_young = 0
    for cid, entry in ledger_map.items():
        title = str(entry.get("title") or "")
        if entry.get("kept"):
            title = str(entry.get("title") or (records.get(cid) or {}).get("title") or "")
            reason = str(entry.get("keep_reason") or "").strip()
            msg = f"kept in ledger ({reason})" if reason else "kept in ledger"
            skipped.append((cid, title, msg))
            continue
        if not _is_valid_uuid(cid):
            skipped.append((cid, title, "invalid UUID"))
            continue
        rec = records.get(cid)
        if not rec:
            skipped.append((cid, title, "not in daemon listings (status unknown)"))
            continue
        title = str(entry.get("title") or rec.get("title") or "")
        if rec.get("starred") and rec.get("pinned"):
            skipped.append((cid, title, "starred and pinned"))
            continue
        if rec.get("starred"):
            skipped.append((cid, title, "starred"))
            continue
        if rec.get("pinned"):
            skipped.append((cid, title, "pinned"))
            continue
        if not rec["status"]:
            skipped.append((cid, title, "not loaded / status unknown"))
            continue
        if not _is_idle_status(rec["status"]):
            skipped.append((cid, title, f"status {rec['status']}"))
            continue
        lm = _parse_iso(rec["lastModifiedTime"])
        if lm is None:
            skipped.append((cid, title, f"unparseable date ({rec['lastModifiedTime'] or 'missing'})"))
            continue
        age = now - lm
        if age < cutoff_delta:
            too_young += 1
            continue
        eligible[cid] = (entry, rec, age)

    # Never delete a parent/ancestor if any known descendant will not be deleted in this run
    # (whether active, too young, starred, status unknown, or not owned by this run).
    blocked_parents = {}
    for rid, rec in records.items():
        if rid in eligible:
            continue
        desc_active = _is_active_status(rec.get("status") or "")
        seen = {rid}
        parent = rec.get("parent") or ""
        while parent and parent not in seen:
            seen.add(parent)
            if desc_active:
                blocked_parents[parent] = f"parent blocked by active descendant {rid[:12]}"
            elif parent not in blocked_parents:
                blocked_parents[parent] = f"parent blocked by non-deleted descendant {rid[:12]}"
            parent = (records.get(parent) or {}).get("parent") or ""

    candidates = []
    for cid, (entry, rec, age) in eligible.items():
        if cid in blocked_parents:
            title = str(entry.get("title") or rec.get("title") or "")
            skipped.append((cid, title, blocked_parents[cid]))
            continue
        candidates.append({
            "id": cid,
            "title": str(entry.get("title") or rec.get("title") or ""),
            "status": rec["status"],
            "age_str": _format_age(int(age.total_seconds())),
            "brain_bytes": _dir_bytes(_brain_dir(cid)),
            "depth": rec.get("depth") or 0,
            "subagent_of": (rec.get("parent") or "") if (entry.get("via_parent") or rec.get("is_subagent")) else "",
        })

    def _print_skips():
        if skipped or too_young:
            print("\nskipped:")
            for scid, stitle, sreason in skipped:
                label = f" ({stitle[:40]})" if stitle else ""
                print(f"  {scid[:12]}{label} — {sreason}")
            if too_young:
                print(f"  {too_young} conversation(s) younger than {args.older_than}")

    if not candidates:
        print("no ledger conversations eligible for gc")
        _print_skips()
        return

    ordered, children_of = _sort_children_first(candidates, records)
    if not args.yes:
        print(f"{'ID':<14} {'AGE':<10} {'STATUS':<24} {'BRAIN':>9}  TITLE")
        for c in ordered:
            title_col = c["title"][:40]
            if c.get("subagent_of"):
                tag = f"subagent of {c['subagent_of'][:12]}"
                title_col = f"{title_col} ({tag})" if title_col else tag
            print(f"{c['id'][:12]:<14} {c['age_str']:<10} {c['status']:<24} "
                  f"{_human(c['brain_bytes']):>9}  {title_col}")
        _print_skips()
        total_brain = sum(c["brain_bytes"] for c in ordered)
        print(f"\ndry run: {len(ordered)} candidate(s), {_human(total_brain)} in brain/. "
              "Re-run with --yes to delete.")
        return

    deleted_ids = set()
    failed_ids = set()
    freed_bytes = 0
    for c in ordered:
        cid = c["id"]
        failed_child = next((ch for ch in children_of.get(cid, ()) if ch in failed_ids), None)
        if failed_child:
            _warn(f"skipping parent {cid}: child {failed_child} was not deleted")
            failed_ids.add(cid)
            continue
        ok_now, reval_reason = _revalidate_gc_candidate(d, cid)
        if not ok_now:
            _warn(f"skipping delete for {cid}: {reval_reason}")
            failed_ids.add(cid)
            continue
        bdir = _brain_dir(cid)
        plock = _presence_lock(cid)
        had_brain_before = bdir.exists() and not bdir.is_symlink()
        pre_brain_bytes = _dir_bytes(bdir)
        pre_lock_bytes = _dir_bytes(plock)
        del_data, del_kind, del_det = _rpc("DeleteCascadeTrajectory", {"cascadeId": cid}, d)
        if del_kind != "ok" or del_data is None:
            _warn(f"failed to delete {cid} ({del_kind}): {del_det}")
            failed_ids.add(cid)
            continue
        gone, reason = _confirm_trajectory_gone(
            d, cid, had_traj, had_search, timeout=getattr(args, "confirm_timeout", 20)
        )
        if not gone:
            _warn(f"refusing disk cleanup for {cid}: {reason}")
            failed_ids.add(cid)
            continue
        brain_left = bdir.exists() and not bdir.is_symlink()
        removed_by_app = had_brain_before and not brain_left
        leftover_brain_bytes = _dir_bytes(bdir) if brain_left else 0
        brain_freed = pre_brain_bytes if removed_by_app else 0
        leftover_lock_bytes = 0
        if plock.exists() or plock.is_symlink():
            leftover_lock_bytes = _dir_bytes(plock)
            plock.unlink()
        item_freed = brain_freed + max(pre_lock_bytes, leftover_lock_bytes)
        freed_bytes += item_freed
        _mark_ledger_deleted(cid)
        deleted_ids.add(cid)
        if brain_left:
            note = f" (leftover: {bdir}, {_human(leftover_brain_bytes)} — not deleted)"
        elif removed_by_app:
            note = " (removed by the app)"
        else:
            note = ""
        print(f"deleted {cid[:12]} ({c['title'] or 'untitled'}) — "
              f"freed {_human(item_freed)} ({item_freed} bytes){note}")

    print(f"\ndeleted {len(deleted_ids)} conversation(s), "
          f"freed {_human(freed_bytes)} ({freed_bytes} bytes)")
    if failed_ids:
        sys.exit(EXIT_ERR)


# --------------------------------------------------------------------------- quota
#
# The plan quota lives in an RPC the agentapi does not expose. The hub's UI reaches it
# over the daemon's TLS port with the session CSRF token — and MEASURED 2026-07-25, that
# token is the SAME string the daemon carries in its process args. So this needs no
# browser, no DevTools port and no WebSocket client: it is one urllib POST with the
# credential `discover()` already holds. (The Electron/CDP route works too — it was
# built and proven first — but it is ~150 lines of hand-rolled WebSocket and it only
# works when the app happens to have been launched with a debug port. Dropped: same
# answer, a tenth of the code, fewer preconditions.)


def _tls_ports(d: Daemon) -> list:
    """Candidate ports for the Connect/gRPC-Web endpoint, derived — never hardcoded.

    The daemon listens on TWO ports: one speaks native gRPC (discover() PROVED which,
    it is the one agentapi uses) and the OTHER serves the hub UI over TLS — that is
    where the Connect RPCs answer. Both numbers change on every boot. Empty when the
    pid is unknown (AGY_BRIDGE_PORT/TOKEN forced) or nothing else listens."""
    if not d.pid:
        return []
    return [p for p in _listen_ports(d.pid) if p != d.port]


def _quota_ports(d: Daemon) -> list:
    """_tls_ports(), but dying with an explanation when there are none."""
    if not d.pid:
        die("agy quota needs the live daemon pid to find its TLS port — unset "
            "AGY_BRIDGE_PORT/AGY_BRIDGE_TOKEN and retry.", EXIT_NO_DAEMON)
    ports = _tls_ports(d)
    if not ports:
        die(f"the daemon (pid {d.pid}) listens on no port besides gRPC — the quota "
            "endpoint is not up.\nOpen the Antigravity app (hub) and retry.", EXIT_NO_DAEMON)
    return ports


class RpcNotAllowed(ValueError):
    """Raised for any daemon method outside RPC_ALLOWLIST — before any I/O happens."""


def _check_allowed(method: str):
    # Exact membership, not a prefix or regex: "Get*" would also admit things like
    # GetTokenBase (a credential reader), and a typo must fail closed.
    if method not in RPC_ALLOWLIST:
        raise RpcNotAllowed(f"daemon RPC '{method}' is not in agy's allowlist")


def _connect_call(port: int, token: str, method: str, body=None):
    """One Connect-protocol call to LanguageServerService. Returns (data, kind, detail) —
    kind as in _classify(). The allowlist is enforced HERE too, so no code path in agy
    can reach a method outside it, not even by skipping _rpc().

    TLS verification is off BY NECESSITY and without loss: the daemon serves a
    self-signed cert for 127.0.0.1 that no trust store can validate. Nothing is weakened
    by it — the host is the literal loopback, the port came from the daemon's own pid via
    lsof, and the local threat model is unchanged (any local process already reads this
    token from `ps`; documented in SKILL.md).

    BOTH csrf headers are required: measured, `x-csrf-token` alone answers 401."""
    _check_allowed(method)
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    req = urllib.request.Request(
        f"https://127.0.0.1:{port}/{RPC_SERVICE}/{method}",
        data=json.dumps(body if body is not None else {}).encode(),
        headers={"content-type": "application/json", "connect-protocol-version": "1",
                 "x-csrf-token": token, "x-codeium-csrf-token": token})
    try:
        with urllib.request.urlopen(req, timeout=CALL_TIMEOUT, context=ctx) as r:
            reply = r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:200]
        return None, ("auth" if e.code in (401, 403) else "app"), f"HTTP {e.code}: {detail}"
    except OSError as e:
        # Wrong sibling port answers here: TLS 'WRONG_VERSION_NUMBER' on the gRPC one.
        return None, "transport", str(getattr(e, "reason", e))[:200]
    try:
        return json.loads(reply), "ok", ""
    except (json.JSONDecodeError, ValueError):
        # A 200 that is not JSON is the daemon answering something else — an app-level
        # problem, not a dead port, and the exit code must say so.
        return None, "app", f"non-JSON reply: {reply[:150]}"


def _quota_rpc(port: int, token: str):
    """The plan-quota call, kept as its own name for cmd_quota's port-proving loop."""
    return _connect_call(port, token, "RetrieveUserQuotaSummary", {})


# The TLS port that answered last, per daemon pid. In-process only (one agy run polls
# the daemon many times in `new`/`gc`); nothing is written anywhere, so the module
# docstring's "no cache" rule across invocations still holds.
_RPC_PORT = {}


def _rpc(method: str, body=None, daemon: Daemon = None):
    """Generic daemon RPC: (data, kind, detail). Refuses — by raising RpcNotAllowed,
    before discovery or any socket — every method outside RPC_ALLOWLIST.

    Port probing is _quota_ports()'s: the sibling of the gRPC port that answers is the
    TLS one, proven by the reply. A reply's kind is returned as-is; only "transport"
    moves on to the next candidate port."""
    _check_allowed(method)
    d = daemon or discover()
    ports = _tls_ports(d)
    if not ports:
        # Not a die(): callers such as the pre-dispatch catalog check must be able to
        # warn and carry on when the daemon's TLS side is not reachable.
        return None, "transport", ("no TLS port: the daemon pid is unknown (AGY_BRIDGE_PORT/"
                                   "TOKEN forced) or it listens on nothing besides gRPC")
    known = _RPC_PORT.get(d.pid)
    if known in ports:
        ports = [known] + [p for p in ports if p != known]
    failures = []
    for port in ports:
        data, kind, detail = _connect_call(port, d.token, method, body)
        if kind != "transport":
            if kind == "ok":
                _RPC_PORT[d.pid] = port
            return data, kind, detail
        failures.append(f"127.0.0.1:{port}: {detail}")
    return None, "transport", "; ".join(failures) or "no TLS port answered"


def _unwrap(data):
    """Connect replies carry the payload either bare or under "response"."""
    if isinstance(data, dict) and isinstance(data.get("response"), dict):
        return data["response"]
    return data if isinstance(data, dict) else {}


