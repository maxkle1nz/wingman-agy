def _first_input_tokens(data):
    gens = _unwrap(data).get("generatorMetadata")
    if not isinstance(gens, list) or not gens:
        return None
    first = gens[0]
    if not isinstance(first, dict):
        return None
    cm = first.get("chatModel") if isinstance(first.get("chatModel"), dict) else {}
    usage = cm.get("usage") if isinstance(cm.get("usage"), dict) else {}
    raw = usage.get("inputTokens")
    if _is_num(raw):
        return int(raw)
    if isinstance(raw, str) and raw.strip().isdigit():
        return int(raw.strip())
    return None


def _doctor_baseline_context(daemon, ledger_entries: list) -> list:
    if daemon is None:
        return [_doctor_check("extensions", "baseline_context", "SKIP", "daemon not running")]
    epoch = datetime.min.replace(tzinfo=timezone.utc)
    active = [
        (idx, e) for idx, e in enumerate(ledger_entries)
        if not e.get("deleted") and e.get("conversationId")
    ]
    active.sort(key=lambda pair: (_parse_iso(str(pair[1].get("ts") or "")) or epoch, pair[0]), reverse=True)
    for _idx, e in active[:5]:  # newest first; unloaded ones fail fast, but cap the RPCs
        cid = str(e.get("conversationId") or "")
        data, kind, _detail = _rpc("GetCascadeTrajectoryGeneratorMetadata", {"cascadeId": cid}, daemon)
        if kind != "ok" or data is None:
            continue
        tokens = _first_input_tokens(data)
        if tokens is not None:
            return [_doctor_check(
                "extensions", "baseline_context", "INFO",
                f"{tokens:,} input tokens (measured on {cid[:8]})")]
    return [_doctor_check("extensions", "baseline_context", "INFO", "nothing to measure")]


