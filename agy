def _render_doctor_text(checks: list, summary: dict):
    sections = []
    by_sec = {}
    for c in checks:
        sec = c["section"]
        if sec not in by_sec:
            sections.append(sec)
            by_sec[sec] = []
        by_sec[sec].append(c)
    name_w = max((len(c["name"]) for c in checks), default=0)
    for sec in sections:
        print(f"== {sec} ==")
        for c in by_sec[sec]:
            msg = f"{c['detail']} — fix: {c['fix']}" if c["fix"] else c["detail"]
            print(f"  {c['level']:<4}  {c['name']:<{name_w}}  {msg}")
    parts = [f"{summary[lvl]} {lvl}" for lvl in DOCTOR_LEVELS]
    print(f"summary: {', '.join(parts)} (exit {summary['exit']})")


