        print(f"\n[{idx}/{total}] {act['title']} {default_tag}")
        print(f"  what       : {act['what']}")
        print(f"  why        : {act['why']}")
        print(f"  how-to-undo: {act['how_to_undo']}")


def _wingman_selftest(plugin_dir: Path, profile: str = "default", python_exe: str = None):
    """Run hook.sh in plugin_dir against a temp ledger and temp WINGMAN_DIR as the app does."""
    if profile not in WINGMAN_PROFILES:
        return False, f"unknown wingman profile: {profile!r}"
    pdir = Path(plugin_dir)
    hook_sh = pdir / "hook.sh"
    if not hook_sh.is_file() or not os.access(hook_sh, os.X_OK):
        return False, f"self-test hook not executable at {hook_sh}"

    py_path = python_exe or sys.executable
    in_scope_cid = "11111111-2222-3333-4444-555555555555"
    out_scope_cid = DUMMY_CONV

    with tempfile.TemporaryDirectory(prefix="agy-selftest-") as td:
        td_path = Path(td)
        temp_wdir = td_path / "wingman"
        temp_wdir.mkdir(mode=0o700)
        py_file = temp_wdir / "python"
        py_file.write_text(str(py_path) + "\n", encoding="utf-8")
        os.chmod(py_file, 0o600)

        temp_ledger = td_path / "ledger.jsonl"
        temp_ledger.write_text(
            json.dumps({
                "ts": "2026-11-15T00:00:00Z",
                "event": "dispatched",
                "conversationId": in_scope_cid,
                "max_invocations": 1,
            }) + "\n",
            encoding="utf-8",
        )

        env = dict(os.environ)
        env["WINGMAN_DIR"] = str(temp_wdir)
        env["AGY_LEDGER"] = str(temp_ledger)
        env.pop("AGY_WINGMAN_MAX_RETRIES", None)

        def _invoke(event: str, payload: dict):
            raw = json.dumps(payload, separators=(",", ":")) + "\n"
            try:
                r = subprocess.run(
                    ["sh", "-c", f"./hook.sh {event}"],
                    input=raw,
                    capture_output=True,
                    text=True,
                    timeout=5,
                    cwd=str(pdir),
                    env=env,
                )
            except (OSError, subprocess.SubprocessError) as e:
                return None, f"self-test {event} failed to run hook.sh: {e}"
            lines = r.stdout.splitlines()
            if r.returncode != 0 or len(lines) != 1:
                preview = (r.stdout or r.stderr or "").strip()[:120]
                return None, f"self-test {event} returned rc={r.returncode}, output={preview!r}"
            try:
                obj = json.loads(lines[0])
            except (json.JSONDecodeError, ValueError):
                return None, f"self-test {event} returned non-JSON: {lines[0][:120]!r}"
            if not isinstance(obj, dict):
                return None, f"self-test {event} returned non-object JSON: {type(obj).__name__}"
            return obj, ""

        obj, err = _invoke("Stop", {
            "conversationId": out_scope_cid,
            "terminationReason": "ERROR",
            "error": "stream idle timeout",
        })
        if err:
            return False, err
        if obj != {}:
            return False, f"self-test Stop (out-of-scope) returned {obj!r}; expected {{}}"

        obj, err = _invoke("Stop", {
            "conversationId": in_scope_cid,
            "terminationReason": "ERROR",
            "error": "stream idle timeout",
        })
        if err:
            return False, err
        if obj.get("decision") != "continue" or not isinstance(obj.get("reason"), str) or not obj.get("reason"):
            return False, f"self-test Stop (in-scope) returned {obj!r}; expected continue decision"

        obj, err = _invoke("PreInvocation", {
            "conversationId": in_scope_cid,
            "invocationNum": 1,
        })
        if err:
            return False, err
        if obj.get("terminationBehavior") != "terminate":
            return False, f"self-test PreInvocation (at cap) returned {obj!r}; expected terminate"

        if profile == "scoped":
            obj, err = _invoke("PreToolUse", {
                "conversationId": out_scope_cid,
                "toolCall": {"name": "run_command", "args": {"CommandLine": "ls"}},
            })
            if err:
                return False, err
            if obj != {"decision": "ask"}:
                return False, f"self-test PreToolUse (out-of-scope) returned {obj!r}; expected ask"

            obj, err = _invoke("PreToolUse", {
                "conversationId": in_scope_cid,
                "toolCall": {"name": "run_command", "args": {"CommandLine": "ls"}},
            })
            if err:
                return False, err
            if obj != {"decision": "allow"}:
                return False, f"self-test PreToolUse (in-scope) returned {obj!r}; expected allow"

    return True, ""


def _create_setup_run_dir() -> Path:
    base = _setup_dir()
    base.mkdir(parents=True, exist_ok=True)
    os.chmod(base, 0o700)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    run_dir = base / stamp
    n = 1
    while run_dir.exists():
        run_dir = base / f"{stamp}-{n}"
        n += 1
    run_dir.mkdir(mode=0o700)
    os.chmod(run_dir, 0o700)
    return run_dir


def _setup_backup_file(src: Path, backups: list, backed_up: set, run_dir: Path, move: bool = False):
    key = str(src)
    if key in backed_up:
        for b in backups:
            if b["path"] == key:
                return Path(b["backup"])
        return None
    if not src.is_file():
        return None
    backups_dir = run_dir / "backups"
    backups_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(backups_dir, 0o700)
    sha = hashlib.sha256(src.read_bytes()).hexdigest()
    dest = backups_dir / src.name
    n = 1
    while dest.exists():
        dest = backups_dir / f"{src.name}-{n}"
        n += 1
    if move:
        shutil.move(str(src), str(dest))
    else:
        shutil.copy2(str(src), str(dest))
    os.chmod(dest, 0o600)
    backups.append({"path": key, "backup": str(dest), "sha256_before": sha})
    backed_up.add(key)
    return dest


def _ask_yes_no(prompt_text: str, default_yes: bool):
    try:
        ans = input(prompt_text)
    except (EOFError, KeyboardInterrupt):
        print("", file=sys.stderr)
        return None
    s = ans.strip().lower()
    if not s:
        return default_yes
    return s in ("y", "yes")


