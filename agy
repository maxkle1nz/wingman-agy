def _wingman_source_dir() -> Path:
    return Path(__file__).resolve().parent / "plugin" / "wingman"


_WINGMAN_KILL_SWITCH = "disable: rm ~/.gemini/config/plugins/wingman"
_WINGMAN_HASHED_FILES = ("plugin.json", "hook.sh", "hook.py", "hooks.json", "skills/agy/SKILL.md")


def _file_sha256_or_none(path: Path):
    try:
        if path.is_file():
            return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        pass
    return None


def _wingman_hooks_text(profile: str) -> str:
    return json.dumps(_wingman_hooks(profile), indent=2, ensure_ascii=False) + "\n"


def _wingman_source_digest(profile: str):
    """sha256 per file of what install-plugin would copy now (hooks.json generated), or None."""
    src = _wingman_source_dir()
    if not src.is_dir():
        return None
    out = {f: _file_sha256_or_none(src / f) for f in ("plugin.json", "hook.sh", "hook.py")}
    if all(v is None for v in out.values()):
        return None
    out["hooks.json"] = hashlib.sha256(_wingman_hooks_text(profile).encode("utf-8")).hexdigest()
    out["skills/agy/SKILL.md"] = _file_sha256_or_none(_agy_skill_source())
    return out


def _wingman_copy_digest(copy_dir):
    """sha256 per file of an installed copy as it is on disk now, or None when dir unreadable."""
    if copy_dir is None:
        return None
    cdir = Path(copy_dir)
    if not cdir.is_dir():
        return None
    return {f: _file_sha256_or_none(cdir / f) for f in _WINGMAN_HASHED_FILES}


def _wingman_install_drift(ws: dict) -> dict:
    """Compare a managed install with its own install.json and with the repo source.

    `modified`: the copy's bytes differ from the sha256 recorded at install time.
    `outdated`: the repo would install different bytes for the same profile. Comparing
    content, not the git rev, keeps unrelated agy commits from reporting an update."""
    ij = ws.get("install_json") or {}
    recorded = ij.get("sha256") if isinstance(ij.get("sha256"), dict) else None
    actual = _wingman_copy_digest(ws.get("installed_dir"))
    source = _wingman_source_digest(ws.get("profile") or "default")
    modified = bool(recorded is not None and actual is not None
                    and any(recorded[f] != actual.get(f) for f in recorded))
    outdated = bool(source is not None and actual is not None
                    and any(source[f] != actual.get(f) for f in source))
    return {"modified": modified, "outdated": outdated}
_WINGMAN_SELFTEST_CACHE = {}
_WINGMAN_HEALTH_CACHE = {}


def _is_under_dir(path: Path, parent: Path) -> bool:
    try:
        rp = path.resolve()
        rparent = parent.resolve()
        return rp != rparent and rp.is_relative_to(rparent)
    except (OSError, ValueError):
        return False


def _wingman_state() -> dict:
    """Inspect wingman plugin installation, config enablement, python interpreter, and metadata."""
    link_path = _plugins_dir() / "wingman"
    installed = (link_path / "plugin.json").is_file()
    is_symlink = link_path.is_symlink()
    installed_dir = None
    if installed:
        try:
            installed_dir = link_path.resolve()
        except OSError:
            installed_dir = None

    enabled = True
    try:
        cfg = json.loads(_antigravity_config().read_text(encoding="utf-8"))
        if isinstance(cfg, dict):
            plugins = cfg.get("plugins")
            if isinstance(plugins, dict):
                wm = plugins.get("wingman")
                if isinstance(wm, dict) and wm.get("enabled") is False:
                    enabled = False
    except (OSError, ValueError):
        pass

    wdir = _wingman_dir()
    python_ok = False
    python_target = ""
    try:
        lines = (wdir / "python").read_text(encoding="utf-8").splitlines()
        py_target = lines[0].strip() if lines else ""
        if py_target:
            python_target = py_target
            tp = Path(py_target).expanduser()
            python_ok = tp.is_file() and os.access(tp, os.X_OK)
    except (OSError, ValueError):
        python_ok = False

    retries = 0
    ev_file = wdir / "events.jsonl"
    try:
        if ev_file.is_file():
            for line in ev_file.read_text(encoding="utf-8", errors="replace").splitlines():
                s = line.strip()
                if not s:
                    continue
                try:
                    obj = json.loads(s)
                except (json.JSONDecodeError, ValueError):
                    continue
                if isinstance(obj, dict) and obj.get("event") == "continue":
                    retries += 1
    except OSError:
        pass

    under_wingman_plugin = bool(installed and is_symlink and _is_under_dir(link_path, wdir / "plugin"))
    install_json = None
    if installed_dir is not None:
        ij_path = installed_dir / "install.json"
        if ij_path.is_file():
            try:
                loaded_ij = json.loads(ij_path.read_text(encoding="utf-8"))
                if isinstance(loaded_ij, dict):
                    install_json = loaded_ij
            except (OSError, ValueError):
                install_json = None

    rev = str(install_json.get("rev") or "-") if install_json else "-"
    daemon_version = str(install_json.get("daemon_version") or "") if install_json else ""
    profile = ""
    if install_json and install_json.get("profile") in WINGMAN_PROFILES:
        profile = install_json["profile"]
    elif installed_dir is not None:
        hj_path = installed_dir / "hooks.json"
        if hj_path.is_file():
            try:
                hj = json.loads(hj_path.read_text(encoding="utf-8"))
                wm_hooks = hj.get("wingman") if isinstance(hj, dict) else None
                if isinstance(wm_hooks, dict):
                    profile = "scoped" if "PreToolUse" in wm_hooks else "default"
            except (OSError, ValueError):
                pass
    if not profile:
        profile = "default"

    return {
        "installed": installed,
        "enabled": enabled,
        "python_ok": python_ok,
        "python_target": python_target,
        "retries": retries,
        "installed_dir": installed_dir,
        "is_symlink": is_symlink,
        "under_wingman_plugin": under_wingman_plugin,
        "install_json": install_json,
        "rev": rev,
        "profile": profile,
        "daemon_version": daemon_version,
    }


def _consent_path() -> Path:
    return Path(os.environ.get("AGY_CONSENT") or "~/.agy/consent.json").expanduser()


def _has_grants_consent(consent_path=None) -> bool:
    p = Path(consent_path) if consent_path else _consent_path()
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return isinstance(data, dict) and data.get("wildcard_grants") is True


def _read_config_grants(path=None):
    """Read config.json and return (data, allow_list, error_str). Never modifies disk."""
    p = Path(path) if path else _antigravity_config()
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        return None, [], str(e)
    if not isinstance(data, dict):
        return None, [], "config root is not a JSON object"
    us = data.get("userSettings")
    if us is not None and not isinstance(us, dict):
        return None, [], "userSettings is not a JSON object"
    gpg = (us or {}).get("globalPermissionGrants")
    if gpg is not None and not isinstance(gpg, dict):
        return None, [], "globalPermissionGrants is not a JSON object"
    allow = (gpg or {}).get("allow")
    if allow is None:
        return data, [], None
    if not isinstance(allow, list):
        return None, [], "globalPermissionGrants.allow is not a list"
    return data, allow, None


def _backup_config(p: Path):
    """Create a dated backup of config.json alongside it before mutating."""
    if not p.exists():
        return None
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%SZ")
    bak = p.with_name(f"{p.name}.bak-{stamp}")
    n = 1
    while bak.exists():
        bak = p.with_name(f"{p.name}.bak-{stamp}-{n}")
        n += 1
    shutil.copy2(p, bak)
    os.chmod(bak, 0o600)
    return bak


def _write_json_atomic(p: Path, data: dict, preserve_mode: bool = False):
    p.parent.mkdir(parents=True, exist_ok=True)
    mode = 0o600
    if preserve_mode:
        try:
            mode = stat.S_IMODE(p.stat().st_mode)
        except OSError:
            mode = 0o600
    fd, tmp_name = tempfile.mkstemp(prefix=p.name + ".agy-tmp-", dir=str(p.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(json.dumps(data, indent=2, ensure_ascii=False))
        os.chmod(tmp_name, mode)
        os.replace(tmp_name, p)
    except BaseException:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def _ensure_full_perm_grants(path=None) -> list:
    """Add the missing FULL_PERM_GRANTS to Antigravity's config with backup. Idempotent.

    Returns the grants it added. Never raises: an unreadable config only warns, because
    a dispatch must not fail over a convenience."""
    p = Path(path) if path else _antigravity_config()
    try:
        data, allow, err = _read_config_grants(p)
        if err is not None:
            raise ValueError(err)
        added = [g for g in FULL_PERM_GRANTS if g not in allow]
        if not added:
            return []
        target = (data.setdefault("userSettings", {})
                      .setdefault("globalPermissionGrants", {})
                      .setdefault("allow", []))
        target.extend(added)
        _backup_config(p)
        _write_json_atomic(p, data)
    except (OSError, ValueError, AttributeError, TypeError) as e:
        print(f"agy: could not ensure auto-approve grants in {p}: {e}", file=sys.stderr)
        return []
    print(f"agy: auto-approve grants added: {', '.join(added)}", file=sys.stderr)
    return added


def _wingman_cache_key(ws: dict):
    inst_dir = ws.get("installed_dir")
    file_sigs = []
    if inst_dir is not None:
        for name in ("plugin.json", "hooks.json", "hook.sh", "hook.py", "install.json", "skills/agy/SKILL.md"):
            fp = inst_dir / name
            try:
                st = fp.stat()
                file_sigs.append((name, st.st_mtime_ns, st.st_size))
            except OSError:
                file_sigs.append((name, None, None))
    py_file = _wingman_dir() / "python"
    try:
        pst = py_file.stat()
        py_sig = (pst.st_mtime_ns, pst.st_size)
    except OSError:
        py_sig = None
    return (
        str(_plugins_dir()),
        str(_wingman_dir()),
        str(_antigravity_config()),
        ws["installed"],
        ws["enabled"],
        ws["python_ok"],
        ws.get("python_target", ""),
        sys.executable,
        str(inst_dir or ""),
        ws["profile"],
        py_sig,
        tuple(file_sigs),
    )


def _wingman_selftest_cached(ws: dict = None):
    if ws is None:
        ws = _wingman_state()
    if not ws["installed"] or ws["installed_dir"] is None:
        return False, "wingman plugin is not installed"
    key = _wingman_cache_key(ws)
    if key in _WINGMAN_SELFTEST_CACHE:
        return _WINGMAN_SELFTEST_CACHE[key]
    py_target = ws.get("python_target") or ""
    if py_target and py_target != sys.executable:
        res = _wingman_selftest(ws["installed_dir"], ws["profile"], python_exe=py_target)
    else:
        res = _wingman_selftest(ws["installed_dir"], ws["profile"])
    _WINGMAN_SELFTEST_CACHE[key] = res
    return res


def _wingman_healthy() -> bool:
    ws = _wingman_state()
    if not (ws["installed"] and ws["enabled"] and ws["python_ok"]):
        return False
    key = _wingman_cache_key(ws)
    if key in _WINGMAN_HEALTH_CACHE:
        return _WINGMAN_HEALTH_CACHE[key]
    ok, _err = _wingman_selftest_cached(ws)
    result = bool(ok)
    _WINGMAN_HEALTH_CACHE[key] = result
    return result


def _check_perm_grants(in_scope: bool = True):
    """Apply FULL_PERM_GRANTS only when consent is recorded; otherwise warn once if absent."""
    if in_scope and _wingman_healthy() and _wingman_state().get("profile") == "scoped":
        return
    data, allow, err = _read_config_grants()
    missing = list(FULL_PERM_GRANTS) if err is not None else [g for g in FULL_PERM_GRANTS if g not in allow]
    if not missing:
        return
    if _has_grants_consent():
        _ensure_full_perm_grants()
        return
    _warn("wildcard grants absent; agent may stop at approval prompts (enable with: agy grants enable)")


def _cmd_grants_status():
    cp = _consent_path()
    cfg = _antigravity_config()
    consented = _has_grants_consent(cp)
    print(f"consent: {'recorded' if consented else 'not recorded'} ({cp})")
    data, allow, err = _read_config_grants(cfg)
    if err is not None:
        print(f"config:  {cfg} (unreadable: {err})")
        present = 0
        for g in FULL_PERM_GRANTS:
            print(f"  [ ] {g}")
    else:
        print(f"config:  {cfg}")
        present = 0
        for g in FULL_PERM_GRANTS:
            mark = "x" if g in allow else " "
            if mark == "x":
                present += 1
            print(f"  [{mark}] {g}")
    print(f"grants:  {present}/{len(FULL_PERM_GRANTS)} present")


def _cmd_grants_enable():
    _require_human_terminal("agy grants enable")
    cp = _consent_path()
    cfg = _antigravity_config()
    if cfg.exists():
        data, allow, err = _read_config_grants(cfg)
        if err is not None:
            die(f"refusing to modify unreadable config {cfg}: {err}", EXIT_ERR)
    else:
        data, allow = {}, []
    print(f"This will record consent in {cp} and add 6 global wildcard grants to {cfg}:")
    for g in FULL_PERM_GRANTS:
        print(f"  {g}")
    try:
        ans = input("Proceed? [y/N]: ")
    except (EOFError, KeyboardInterrupt):
        print("", file=sys.stderr)
        die("aborted; no changes made", EXIT_ERR)
    if ans.strip().lower() not in ("y", "yes"):
        die("aborted; no changes made", EXIT_ERR)
    _write_json_atomic(cp, {
        "wildcard_grants": True,
        "grants": list(FULL_PERM_GRANTS),
        "ts": _now_iso(),
    })
    bak = _backup_config(cfg) if cfg.exists() else None
    added = [g for g in FULL_PERM_GRANTS if g not in allow]
    if added or not cfg.exists():
        target = (data.setdefault("userSettings", {})
                      .setdefault("globalPermissionGrants", {})
                      .setdefault("allow", []))
        target.extend(added)
        _write_json_atomic(cfg, data)
    print(f"consent recorded: {cp}")
    if bak:
        print(f"backup: {bak}")
    if added:
        print(f"added grants: {', '.join(added)}")
    else:
        print("all 6 wildcard grants were already present")


def _cmd_grants_disable():
    cp = _consent_path()
    cfg = _antigravity_config()
    removed_consent = False
    if cp.exists():
        cp.unlink()
        removed_consent = True
    removed_grants = []
    bak = None
    if cfg.exists():
        data, allow, err = _read_config_grants(cfg)
        if err is not None:
            die(f"refusing to modify unreadable config {cfg}: {err}", EXIT_ERR)
        kept = [g for g in allow if g not in FULL_PERM_GRANTS]
        removed_grants = [g for g in allow if g in FULL_PERM_GRANTS]
        if removed_grants:
            bak = _backup_config(cfg)
            data["userSettings"]["globalPermissionGrants"]["allow"] = kept
            _write_json_atomic(cfg, data)
    print(f"consent: {'removed' if removed_consent else 'not present'} ({cp})")
    if bak:
        print(f"backup: {bak}")
    if removed_grants:
        print(f"removed grants: {', '.join(removed_grants)}")
    else:
        print("removed grants: none")


def cmd_grants(args):
    sub = getattr(args, "grants_cmd", None)
    if sub == "enable":
        return _cmd_grants_enable()
    if sub == "disable":
        return _cmd_grants_disable()
    return _cmd_grants_status()


def _require_yes(args, action: str, why="drives an autonomous Antigravity agent and spends Gemini quota"):
    if not args.yes:
        die(f"'{action}' {why}.\n"
            "Re-run with --yes to confirm.", EXIT_ERR)


def cmd_new(args):
    _require_yes(args, "agy new")
    max_inv = getattr(args, "max_invocations", None)
    if max_inv is not None and max_inv < 1:
        die("--max-invocations must be >= 1", EXIT_ERR)
    d = discover()
    # Before anything is written or dispatched: an unknown id would silently run Flash.
    cat, expected = _check_model(args.model, getattr(args, "allow_fallback", False), d)
    if max_inv is not None and not _wingman_healthy():
        _warn("--max-invocations has no enforcement because wingman is not healthy "
              "(install/check with: agy setup)")
    _check_perm_grants()
    # new-conversation needs the workspace's projectId (a UUID the app assigns).
    # Explicit --project wins; otherwise resolve it from --workspace (or cwd).
    # Design rule: the DEFAULT dispatch workspace is ALWAYS the clean
    # sandbox — agents are never born inside a real project (or the registered $HOME
    # workspace!) by accident. Dispatch from anywhere; the agent's terminal reaches any
    # path (the native wildcard grants of _ensure_full_perm_grants answer the prompts).
    # Explicit escapes: --here (use the cwd's workspace), --workspace PATH, --project UUID,
    # or ANTIGRAVITY_PROJECT_ID.
    project = args.project or os.environ.get("ANTIGRAVITY_PROJECT_ID")
    if project:
        workspace = args.workspace or os.getcwd()
    elif args.workspace:
        workspace = args.workspace
        project = _project_for_workspace(d, workspace)
    elif args.here:
        workspace = os.getcwd()
        project = _project_for_workspace(d, workspace)
    else:
        workspace = os.environ.get("AGY_SANDBOX_WORKSPACE",
                                   os.path.expanduser("~/agy-sandbox"))
        project = _project_for_workspace(d, workspace)
        if project:
            print(f"agy: dispatching in the clean sandbox ({workspace}) — use --here "
                  f"for the cwd's workspace", file=sys.stderr)
        else:
            project = "outside-of-project"
            print(f"agy: no project for sandbox ({workspace}); falling back to "
                  f"--project outside-of-project", file=sys.stderr)
    if not project:
        die("could not resolve an Antigravity projectId for\n"
            f"  {os.path.realpath(workspace)}\n"
            "Open that folder once in the Antigravity app (so it gets a project),\n"
            "or pass --project <uuid> (see the id in `agy show <conv>` of that workspace).",
            EXIT_ERR)
    env_extra = {"ANTIGRAVITY_PROJECT_ID": project}
    cmd = ["new-conversation", f"--model={args.model}"]
    if args.title:
        cmd.append(f"--title={args.title}")
    cmd.append(args.prompt)
    raw, kind, err = _agentapi(d.port, d.token, cmd, timeout=60, extra_env=env_extra)
    if err or kind != "ok":
        die(err or _short_err(raw), _exit_code_for(kind))
    _die_on_app_error(raw)
    _print_json(raw)
    conv = _conversation_id(raw)
    if not conv:
        _warn("warning: the reply carries no conversationId, so the model that ran "
              "cannot be verified")
        sys.exit(EXIT_UNVERIFIED)
    print(f"\nfollow it:  agy tail {conv[:8]} -f", file=sys.stderr)
    # Record dispatch immediately before verification polling so an interrupted or failed
    # verification never leaves a running conversation outside the ledger.
    dispatched = {
        "ts": _now_iso(),
        "event": "dispatched",
        "conversationId": conv,
        "requested_model": args.model,
        "ran_model": None,
        "title": args.title or "",
        "project": project,
    }
    if max_inv is not None:
        dispatched["max_invocations"] = max_inv
    _record_ledger_event(dispatched)
    if getattr(args, "keep", False):
        _record_ledger_event({
            "ts": _now_iso(),
            "event": "kept",
            "conversationId": conv,
            "reason": "--keep at dispatch",
        })
    ran = None
    code = EXIT_OK
    if not getattr(args, "no_verify", False):
        ran, verify_err = _await_ran_model(d, conv, getattr(args, "verify_timeout", 60))
        if ran is None:
            if verify_err:
                _warn(f"warning: could not verify model that ran ({verify_err}); "
                      f"check later with: agy show {conv[:8]}")
            else:
                _warn(f"warning: no model reported within {getattr(args, 'verify_timeout', 60)}s; "
                      f"check later with: agy show {conv[:8]}")
            code = EXIT_UNVERIFIED
        else:
            code = _report_ran(args.model, expected, ran, cat)
    _record_ledger_event({
        "ts": _now_iso(),
        "event": "verified" if ran is not None else "unverified",
        "conversationId": conv,
        "ran_model": ran[0] if ran else None,
    })
    if code:
        sys.exit(code)


_CONV_ID_KEYS = ("conversationId", "cascadeId")


def _extract_conv_id(obj, depth=0) -> str:
    if depth > 6:
        return ""
    if isinstance(obj, dict):
        for key in _CONV_ID_KEYS:
            val = obj.get(key)
            if isinstance(val, str):
                cand = val.strip()
                if _UUID_RE.match(cand):
                    return cand
        for v in obj.values():
            if isinstance(v, (dict, list)):
                found = _extract_conv_id(v, depth + 1)
                if found:
                    return found
    elif isinstance(obj, list):
        for item in obj:
            if isinstance(item, (dict, list)):
                found = _extract_conv_id(item, depth + 1)
                if found:
                    return found
    return ""


def _conversation_id(raw: str) -> str:
    """Extract and UUID-validate conversationId/cascadeId from top-level or nested agentapi JSON."""
    try:
        j = json.loads(raw)
    except (json.JSONDecodeError, ValueError):
        return ""
    return _extract_conv_id(j)


def cmd_send(args):
    _require_yes(args, "agy send")
    # agentapi accepts any string as a recipient: a short prefix silently creates an
    # "undelivered" mailbox in brain/<prefix>/ and the message never reaches the agent.
    if not _is_valid_uuid(args.recipient):
        args.recipient = _resolve_conv(args.recipient)
    in_scope = any(
        e.get("conversationId") == args.recipient and not e.get("deleted")
        for e in _read_ledger()
    )
    _check_perm_grants(in_scope=in_scope)
    d = discover()
    verify = not getattr(args, "no_verify", False)
    before = 0
    history_err = ""
    if verify:
        # The new turn's model is the first generator call AFTER the ones already there.
        ran_before, verr = _generator_models(d, args.recipient)
        if verr:
            _warn(f"note: cannot read the model history of {args.recipient} ({verr}); "
                  "the model that answers will not be verified")
            history_err = verr
            verify = False
        before = len(ran_before)
    cmd = ["send-message"]
    if args.title:
        cmd.append(f"--title={args.title}")
    cmd += [args.recipient, args.content]
    raw, kind, err = _agentapi(d.port, d.token, cmd, timeout=60)
    if err or kind != "ok":
        die(err or _short_err(raw), _exit_code_for(kind))
    _die_on_app_error(raw)
    _print_json(raw)
    if history_err:
        sys.exit(EXIT_UNVERIFIED)
    if not verify:
        return
    conv = _conversation_id(raw) or args.recipient
    ran, verify_err = _await_ran_model(d, conv, getattr(args, "verify_timeout", 60), skip=before)
    if ran is None:
        if verify_err:
            _warn(f"warning: could not verify model that ran ({verify_err}); "
                  f"check later with: agy show {conv[:8]}")
        else:
            _warn(f"warning: no new model call within {getattr(args, 'verify_timeout', 60)}s; "
                  f"check later with: agy show {conv[:8]}")
        sys.exit(EXIT_UNVERIFIED)
    requested, expected, cat = _send_expectation(d, conv)
    if requested is None:
        _warn(f"ran: {ran[1] or '?'} ({ran[0]})")
        return
    code = _report_ran(requested, expected, ran, cat)
    if code:
        sys.exit(code)


def _now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _ledger_path() -> Path:
    return Path(os.environ.get("AGY_LEDGER", "~/.agy/ledger.jsonl")).expanduser()


@contextlib.contextmanager
def _ledger_lock(p: Path):
    """Hold an exclusive flock on the live ledger inode across reads/writes/replaces."""
    p.parent.mkdir(parents=True, exist_ok=True)
    while True:
        f = open(p, "a+", encoding="utf-8")
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        try:
            st_fd = os.fstat(f.fileno())
            st_path = os.stat(p)
            if (st_fd.st_dev, st_fd.st_ino) == (st_path.st_dev, st_path.st_ino):
                break
        except FileNotFoundError:
            pass
        fcntl.flock(f.fileno(), fcntl.LOCK_UN)
        f.close()
    try:
        yield f
    finally:
        try:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
        finally:
            f.close()


def _parse_ledger_lines(text: str, p: Path) -> list:
    rows = []
    for lineno, line in enumerate(text.splitlines(), 1):
        s = line.strip()
        if not s:
            continue
        try:
            obj = json.loads(s)
        except (json.JSONDecodeError, ValueError):
            _warn(f"warning: ignoring malformed ledger line {lineno} in {p}")
            continue
        if isinstance(obj, dict):
            rows.append(obj)
    return rows


def _fold_ledger(rows: list) -> list:
    """Fold per-conversationId events (and legacy whole-entry lines) into one dict per id."""
    folded = {}
    anon = []
    for obj in rows:
        cid = str(obj.get("conversationId") or "")
        if not cid:
            anon.append(dict(obj))
            continue
        cur = folded.get(cid)
        ev = obj.get("event")
        if cur is None:
            cur = dict(obj)
            folded[cid] = cur
        else:
            if ev == "dispatched" or "event" not in obj:
                for k, v in obj.items():
                    if k == "ts" and cur.get("ts"):
                        continue
                    if v is not None or k not in cur:
                        cur[k] = v
            else:
                if obj.get("ran_model") is not None:
                    cur["ran_model"] = obj["ran_model"]
                for k in ("requested_model", "planned_model", "title", "project"):
                    if obj.get(k) and not cur.get(k):
                        cur[k] = obj[k]
                if obj.get("max_invocations") is not None and cur.get("max_invocations") is None:
                    cur["max_invocations"] = obj["max_invocations"]
                if ev and ev not in ("kept", "unkept"):
                    cur["event"] = ev
            if obj.get("adopted"):
                cur["adopted"] = True
        if ev == "verified":
            cur["verified"] = True
        elif ev == "unverified":
            cur["verified"] = False
        elif ev == "kept":
            cur["kept"] = True
            cur["keep_reason"] = str(obj.get("reason") or "")
        elif ev == "unkept":
            cur["kept"] = False
            cur["keep_reason"] = ""
        if obj.get("deleted") or ev in ("deleted", "reconciled"):
            cur["deleted"] = True
        if obj.get("reconciled") or ev == "reconciled":
            cur["deleted"] = True
            cur["reconciled"] = True
    return list(folded.values()) + anon


def _read_ledger() -> list:
    """Read ledger.jsonl and fold events per conversationId, tolerating legacy lines."""
    p = _ledger_path()
    if not p.is_file():
        return []
    with open(p, "r", encoding="utf-8", errors="replace") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_SH)
        try:
            text = f.read()
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
    return _fold_ledger(_parse_ledger_lines(text, p))


def _rewrite_ledger_under_lock(mutate_fn):
    p = _ledger_path()
    with _ledger_lock(p) as f:
        f.seek(0)
        rows = _parse_ledger_lines(f.read(), p)
        if mutate_fn(rows):
            tmp = p.with_name(p.name + ".agy-tmp")
            tmp.write_text("".join(json.dumps(e, ensure_ascii=False) + "\n" for e in rows), encoding="utf-8")
            os.replace(tmp, p)


def _append_ledger(entry: dict):
    p = _ledger_path()
    line = json.dumps(entry, ensure_ascii=False) + "\n"
    with _ledger_lock(p) as f:
        f.write(line)
        f.flush()


def _record_ledger_event(entry: dict):
    try:
        _append_ledger(entry)
    except OSError as e:
        _warn(f"warning: could not write ledger {_ledger_path()}: {e}")


def _send_expectation(d: Daemon, conv: str):
    """(requested, expected, catalog) for a conversation agy dispatched itself, from the
    ledger; (None, None, None) when agy has no record of what was asked for."""
    requested = None
    for entry in reversed(_read_ledger()):
        if entry.get("conversationId") == conv and not entry.get("deleted"):
            requested = entry.get("requested_model") or entry.get("planned_model") or None
            break
    if not requested:
        return None, None, None
    cat, _why = _catalog(d)
    expected = (cat or {}).get("tiers", {}).get(requested) if requested in TIERS else requested
    return requested, expected, cat


def _resolve_adopt_id(raw_id: str, daemon: Daemon, daemon_ids: set) -> str:
    disk_ids = {cid for cid, _fmt, _p in _conversations()}
    all_ids = sorted(disk_ids | daemon_ids)
    if raw_id in all_ids:
        return raw_id
    matches = [i for i in all_ids if i.startswith(raw_id)]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        die(f"'{raw_id}' is ambiguous: {', '.join(m[:12] for m in matches)}")
    if len(raw_id) >= 32:
        data, kind, _detail = _rpc("GetConversationMetadata", {"conversationId": raw_id}, daemon)
        if kind == "ok" and data is not None:
            return raw_id
    die(f"no conversation matches '{raw_id}' (see: agy ls)")


def _cmd_ledger_list():
    entries = _read_ledger()
    if not entries:
        print(f"ledger is empty ({_ledger_path()})")
        return
    print(f"{'ID':<14} {'TS':<20} {'REQUESTED':<24} {'RAN':<24} {'FLAGS':<16} TITLE")
    for e in entries:
        cid = str(e.get("conversationId") or "?")
        ts = str(e.get("ts") or "")[:19].replace("T", " ")
        req_val = e.get("requested_model")
        if req_val:
            req = str(req_val)[:24]
        elif e.get("planned_model"):
            req = f"plan:{e['planned_model']}"[:24]
        else:
            req = "-"
        ran = str(e.get("ran_model") or "-")[:24]
        flags = []
        if e.get("adopted"):
            flags.append("adopted")
        if e.get("kept"):
            flags.append("kept")
        if e.get("deleted"):
            flags.append("deleted")
        if e.get("reconciled"):
            flags.append("reconciled")
        if not e.get("deleted") and not e.get("adopted") and (
            e.get("verified") is False or e.get("event") == "dispatched"
        ):
            flags.append("unverified")
        flag_s = ",".join(flags) or "active"
        title = str(e.get("title") or "")[:40]
        print(f"{cid[:12]:<14} {ts:<20} {req:<24} {ran:<24} {flag_s:<16} {title}")


def _cmd_ledger_adopt(ids: list):
    d = discover()
    traj_data, _tkind, _tdet = _rpc("GetAllCascadeTrajectories", {}, d)
    traj_map = (_unwrap(traj_data).get("trajectorySummaries") or {}) if traj_data else {}
    search_data, _skind, _sdet = _rpc("SearchConversations", {"query": "", "limit": 200}, d)
    search_map = {}
    for item in (_unwrap(search_data).get("results") or []) if search_data else []:
        if isinstance(item, dict) and item.get("cascadeId"):
            search_map[str(item["cascadeId"])] = item
    daemon_ids = set(traj_map.keys()) | set(search_map.keys())

    cat, _cwhy = _catalog(d)
    enum_to_id = {}
    for mid, info in ((cat or {}).get("models") or {}).items():
        if info.get("enum") and not info.get("disabled"):
            enum_to_id.setdefault(info["enum"], mid)

    existing = _read_ledger()
    known_ids = {str(e.get("conversationId") or "") for e in existing}
    for raw_id in ids:
        cid = _resolve_adopt_id(raw_id, d, daemon_ids)
        if cid in known_ids:
            _warn(f"already in ledger: {cid}")
            continue
        meta_data, _mkind, _mdet = _rpc("GetConversationMetadata", {"conversationId": cid}, d)
        mu = _unwrap(meta_data)
        meta = (mu.get("conversationMetadata") or {}).get("metadata") or mu.get("metadata") or {}
        if not isinstance(meta, dict):
            meta = {}
        project = str(meta.get("projectId") or "")
        ts = str(meta.get("createdAt") or "") or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        plan_enum = str((((meta.get("staticConfig") or {}).get("cascadeConfig") or {})
                         .get("plannerConfig") or {}).get("planModel") or "")
        planned_model = enum_to_id.get(plan_enum) or plan_enum or None
        ran_list, _rerr = _generator_models(d, cid)
        ran_model = ran_list[0][0] if ran_list else None
        tinfo = traj_map.get(cid) or {}
        sinfo = search_map.get(cid) or {}
        ann = tinfo.get("annotations") if isinstance(tinfo.get("annotations"), dict) else {}
        title = str(ann.get("title") or tinfo.get("summary") or sinfo.get("title") or "")
        entry = {
            "ts": ts,
            "conversationId": cid,
            "requested_model": None,
            "planned_model": planned_model,
            "ran_model": ran_model,
            "title": title,
            "project": project,
            "adopted": True,
        }
        _append_ledger(entry)
        known_ids.add(cid)
        print(f"adopted {cid} ({title or 'untitled'})")


def _reconcile_ledger(entries: list, records: dict) -> list:
    """Mark active ledger entries absent from both daemon listings and brain/ as deleted+reconciled."""
    reconciled = []
    target_ids = set()
    for e in entries:
        cid = str(e.get("conversationId") or "")
        if not cid or e.get("deleted") or not _is_valid_uuid(cid):
            continue
        bdir = _brain_dir(cid)
        if cid in records or bdir.exists() or bdir.is_symlink():
            continue
        e["deleted"] = True
        e["reconciled"] = True
        target_ids.add(cid)
        reconciled.append(e)
    if target_ids:
        def _mutate(rows):
            changed = False
            for r in rows:
                if str(r.get("conversationId") or "") in target_ids and not (
                    r.get("deleted") and r.get("reconciled")
                ):
                    r["deleted"] = True
                    r["reconciled"] = True
                    changed = True
            return changed
        _rewrite_ledger_under_lock(_mutate)
    return reconciled


def _cmd_ledger_reconcile():
    entries = _read_ledger()
    if not entries:
        print(f"ledger is empty ({_ledger_path()})")
        return
    if not any(e.get("conversationId") and not e.get("deleted") for e in entries):
        print("ledger is up to date (0 reconciled)")
        return
    d = discover()
    records, kind, detail, (had_traj, had_search) = _daemon_trajectories(d)
    if records is None:
        die(f"cannot read conversation listings from daemon ({kind}): {detail}", _exit_code_for(kind))
    if not (had_traj and had_search):
        die("cannot reconcile: both GetAllCascadeTrajectories and SearchConversations must succeed", EXIT_ERR)
    reconciled = _reconcile_ledger(entries, records)
    for e in reconciled:
        cid = str(e.get("conversationId") or "")
        print(f"reconciled {cid} ({e.get('title') or 'untitled'})")
    if not reconciled:
        print("ledger is up to date (0 reconciled)")


def _resolve_ledger_id(raw_id: str, entries: list) -> str:
    """Resolve a full UUID or >=8-char prefix against non-deleted ledger entries."""
    raw = raw_id.strip()
    if len(raw) < 8:
        die(f"id '{raw_id}' is too short (need a full UUID or at least 8 characters)", EXIT_ERR)
    active_ids = [str(e.get("conversationId") or "") for e in entries
                  if e.get("conversationId") and not e.get("deleted")]
    deleted_ids = [str(e.get("conversationId") or "") for e in entries
                   if e.get("conversationId") and e.get("deleted")]
    low = raw.lower()
    exact = [i for i in active_ids if i.lower() == low]
    if exact:
        return exact[0]
    matches = [i for i in active_ids if i.lower().startswith(low)]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        die(f"'{raw_id}' is ambiguous: {', '.join(m[:12] for m in matches)}", EXIT_ERR)
    del_matches = [i for i in deleted_ids if i.lower() == low or i.lower().startswith(low)]
    if len(del_matches) == 1:
        die(f"conversation '{del_matches[0]}' is deleted in ledger", EXIT_ERR)
    if del_matches:
        die(f"'{raw_id}' matches only deleted ledger conversations: "
            f"{', '.join(m[:12] for m in del_matches)}", EXIT_ERR)
    die(f"no active ledger conversation matches '{raw_id}' (see: agy ledger)", EXIT_ERR)


def _cmd_ledger_keep(ids: list, keep: bool, reason: str = ""):
    entries = _read_ledger()
    by_id = {str(e.get("conversationId") or ""): e for e in entries if e.get("conversationId")}
    resolved = []
    for raw_id in ids:
        cid = _resolve_ledger_id(raw_id, entries)
        if cid not in resolved:
            resolved.append(cid)
    ev = "kept" if keep else "unkept"
    for cid in resolved:
        row = {"ts": _now_iso(), "event": ev, "conversationId": cid}
        if keep:
            row["reason"] = reason
        _append_ledger(row)
        title = str((by_id.get(cid) or {}).get("title") or "") or "untitled"
        if keep and reason:
            print(f"kept {cid} ({title}) — {reason}")
        else:
            print(f"{ev} {cid} ({title})")


def cmd_ledger(args):
    if getattr(args, "ledger_cmd", None) == "adopt":
        return _cmd_ledger_adopt(args.ids)
    if getattr(args, "ledger_cmd", None) == "reconcile":
        return _cmd_ledger_reconcile()
    if getattr(args, "ledger_cmd", None) == "keep":
        return _cmd_ledger_keep(args.ids, keep=True, reason=args.reason)
    if getattr(args, "ledger_cmd", None) == "unkeep":
        return _cmd_ledger_keep(args.ids, keep=False)
    return _cmd_ledger_list()


