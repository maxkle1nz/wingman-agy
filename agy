# Classic keys are "AIza" + 35 chars; newer AI Studio keys are longer and carry a "." (e.g. a
# 2-char prefix, a dot, then the body). None of these characters can split a `security -i` line.
_API_KEY_FORMAT_RE = re.compile(r"^[A-Za-z0-9._-]{20,200}$")
_ENV_KEY_ASSIGN_RE = re.compile(r"^\s*(?:export\s+)?(GEMINI_API_KEY|GOOGLE_API_KEY)\s*=\s*(.*)$")
_KEYCHAIN_ACCT_RE = re.compile(r'"acct"<blob>="([^"]*)"')
_KEYCHAIN_ACCOUNT_SAFE_RE = re.compile(r"^[A-Za-z0-9._@-]{1,64}$")
_API_KEY_ENV_VARS = ("GEMINI_API_KEY", "GOOGLE_API_KEY")
_API_KEY_DOTENV_FILES = ("~/.gemini/.env", "~/.env")
_API_KEY_SHELL_PROFILES = (
    "~/.zshrc",
    "~/.zprofile",
    "~/.zshenv",
    "~/.bashrc",
    "~/.bash_profile",
    "~/.profile",
)
_AISTUDIO_APIKEY_URL = "https://aistudio.google.com/apikey"


def _key_fingerprint(key: str) -> str:
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:8]


def _is_valid_api_key_format(val: str) -> bool:
    return bool(
        isinstance(val, str)
        and not any(ch in val for ch in ("$", "`", "("))
        and _API_KEY_FORMAT_RE.fullmatch(val)
    )


def _extract_env_assignment_value(rhs: str) -> str:
    s = rhs.strip()
    if not s:
        return ""
    if s[0] in ('"', "'"):
        q = s[0]
        m = re.match(rf"^{q}([^{q}]*){q}(?:\s*(?:#.*)?)?$", s)
        if not m:
            return ""
        val = m.group(1)
    else:
        val = s.split("#", 1)[0].strip()
    return val if _is_valid_api_key_format(val) else ""


def _discover_api_key_candidates() -> list:
    """Collect candidate Gemini API keys in source-priority order, deduped by value."""
    candidates = []
    seen = set()

    def _add(key: str, source: str):
        if _is_valid_api_key_format(key) and key not in seen:
            seen.add(key)
            candidates.append({"key": key, "source": source, "fingerprint": _key_fingerprint(key)})

    for var in _API_KEY_ENV_VARS:
        val = os.environ.get(var, "").strip()
        _add(val, f"env {var}")

    for raw_path in _API_KEY_DOTENV_FILES + _API_KEY_SHELL_PROFILES:
        p = Path(raw_path).expanduser()
        try:
            if not p.is_file():
                continue
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for lineno, line in enumerate(text.splitlines(), 1):
            m = _ENV_KEY_ASSIGN_RE.match(line)
            if not m:
                continue
            val = _extract_env_assignment_value(m.group(2))
            if val:
                _add(val, f"{raw_path} line {lineno}")

    account = _api_account()
    for svc in API_KEY_SERVICES:
        try:
            r_acct = _run(["security", "find-generic-password", "-s", svc, "-a", account, "-w"])
        except (OSError, subprocess.SubprocessError):
            r_acct = None
        if r_acct is not None and r_acct.returncode == 0:
            _add(r_acct.stdout.strip(), f"Keychain {svc} (account {account})")

        try:
            r_any = _run(["security", "find-generic-password", "-s", svc, "-w"])
        except (OSError, subprocess.SubprocessError):
            r_any = None
        if r_any is not None and r_any.returncode == 0:
            val = r_any.stdout.strip()
            if _is_valid_api_key_format(val) and val not in seen:
                acct_label = ""
                try:
                    r_attr = _run(["security", "find-generic-password", "-s", svc])
                except (OSError, subprocess.SubprocessError):
                    r_attr = None
                if r_attr is not None and r_attr.returncode == 0:
                    am = _KEYCHAIN_ACCT_RE.search(r_attr.stdout or "")
                    if am and am.group(1).strip():
                        acct_label = am.group(1).strip()
                src = f"Keychain {svc} (account {acct_label})" if acct_label else f"Keychain {svc}"
                _add(val, src)

    return candidates


def _validate_api_key(key: str) -> str:
    """Validate a candidate key via GET /models?pageSize=1 with x-goog-api-key header."""
    req = urllib.request.Request(
        f"{API_BASE}/models?pageSize=1",
        headers={"x-goog-api-key": key},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            status = getattr(r, "status", 200)
            return "valid" if status == 200 else "unknown"
    except urllib.error.HTTPError as e:
        if e.code in (400, 401, 403):
            return "invalid"
        return "unknown"
    except (OSError, urllib.error.URLError, ValueError):
        return "unknown"


def _same_link_location(a: Path, b: Path) -> bool:
    if str(a) == str(b):
        return True
    try:
        return a.resolve() == b.resolve()
    except OSError:
        return False


def _wingman_link_managed_by_manifest(link_path: Path) -> bool:
    """Return True if the newest non-undone setup manifest owns the current wingman symlink."""
    if not link_path.is_symlink():
        return False
    sdir = _setup_dir()
    if not sdir.is_dir():
        return False
    try:
        cur_raw = os.readlink(link_path)
    except OSError:
        return False
    cur_target = Path(cur_raw)
    if not cur_target.is_absolute():
        cur_target = link_path.parent / cur_target
    for d in sorted(sdir.iterdir(), key=lambda p: p.name, reverse=True):
        if not d.is_dir():
            continue
        mf = d / "manifest.json"
        if not mf.is_file():
            continue
        try:
            data = json.loads(mf.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(data, dict) or data.get("undone") is not None:
            continue
        for act in reversed(data.get("actions") or []):
            if not isinstance(act, dict) or not act.get("applied"):
                continue
            for ch in reversed(act.get("changes") or []):
                if not isinstance(ch, dict) or ch.get("kind") != "symlink":
                    continue
                if _same_link_location(Path(str(ch.get("path") or "")), link_path):
                    recorded = Path(str(ch.get("target") or ""))
                    return _same_link_location(recorded, cur_target)
    return False


def _setup_plan(scoped: bool = False):
    """Inspect current host state read-only and return (actions, notes, refusals)."""
    actions, notes, refusals = [], [], []

    daemon, _daemon_err = _probe_daemon_optional()
    src = _wingman_source_dir()
    plugins_dir = _plugins_dir()
    link_path = plugins_dir / "wingman"
    wdir = _wingman_dir()
    py_file = wdir / "python"
    rev = _agy_git_rev()
    desired_profile = "scoped" if scoped else "default"
    copy_dir = wdir / "plugin" / f"{rev}-{desired_profile}"
    ws = _wingman_state()

    install_available = False
    if not link_path.is_symlink() and link_path.exists():
        kind = "directory" if link_path.is_dir() else "file"
        refusals.append(
            f"install-plugin: {link_path} exists as a real {kind}; will not overwrite it"
        )
    else:
        install_available = True
        symlink_ok = False
        if link_path.is_symlink() and copy_dir.is_dir():
            try:
                symlink_ok = link_path.resolve() == copy_dir.resolve()
            except OSError:
                symlink_ok = False
        if ws["under_wingman_plugin"] and ws["install_json"] is not None:
            # A managed copy (same or older rev) is current only when its bytes still match.
            drift = _wingman_install_drift(ws)
            symlink_ok = not drift["modified"] and not drift["outdated"]
        unmanaged = link_path.is_symlink() and not _wingman_link_managed_by_manifest(link_path)
        daemon_mismatch = bool(
            daemon is not None and daemon.version and ws["daemon_version"]
            and daemon.version != ws["daemon_version"]
        )
        selftest_ok = bool(ws["installed"] and ws["python_ok"] and _wingman_selftest_cached(ws)[0])
        profile_ok = ws["profile"] == desired_profile
        if (
            not symlink_ok
            or not ws["python_ok"]
            or unmanaged
            or daemon_mismatch
            or not selftest_ok
            or not profile_ok
        ):
            if unmanaged:
                title = "replace the unmanaged wingman install with a managed one"
            elif ws["installed"] and ws["under_wingman_plugin"] and ws["install_json"] is not None:
                title = "update the wingman plugin (newer hooks or agy skill, or Antigravity updated)"
            else:
                title = "install the wingman plugin and configure its Python runner"
            dest_desc = str(copy_dir)
            try:
                live_same = ws["installed_dir"] is not None and copy_dir.resolve() == ws["installed_dir"]
            except (OSError, RuntimeError):
                live_same = False
            if live_same:
                # _apply_install_plugin never rewrites the live copy in place; say where it really goes.
                dest_desc = f"{copy_dir}-<UTC timestamp> (new dir; the live {copy_dir} is kept for undo)"
            actions.append({
                "id": "install-plugin",
                "kind": "install-plugin",
                "profile": desired_profile,
                "title": title,
                "default_yes": True,
                "what": (
                    f"mkdir -p {wdir} (0700), write {py_file} -> {sys.executable}, "
                    f"copy plugin ({desired_profile} profile) into {dest_desc}, "
                    f"run self-test, and symlink {link_path} -> that copy"
                ),
                "why": "retries transport errors and enforces --max-invocations for agy-dispatched conversations",
                "how_to_undo": (
                    f"remove {link_path} (restoring any prior symlink), "
                    f"remove the new copy dir if created by setup, and remove {py_file} if created by setup"
                ),
            })

    cfg_path = _antigravity_config()
    cfg_data, allow, cfg_err = _read_config_grants(cfg_path)
    if cfg_path.exists() and cfg_err is not None:
        notes.append(f"config unreadable ({cfg_path}): {cfg_err}; grants and plugins not checked")
    present_grants = [g for g in FULL_PERM_GRANTS if g in allow] if cfg_err is None else []

    wingman_scoped_healthy = _wingman_healthy() and ws["profile"] == "scoped"
    if scoped and present_grants and (wingman_scoped_healthy or install_available):
        consent_note = (
            f" and move {_consent_path()} into the backup dir" if _consent_path().exists() else ""
        )
        actions.append({
            "id": "scoped-approvals",
            "kind": "scoped-approvals",
            "title": f"switch to scoped approvals (remove {len(present_grants)} agy wildcard grant(s) from config.json)",
            "default_yes": False,
            "what": f"remove {', '.join(present_grants)} from {cfg_path} (keeping every other grant){consent_note}",
            "why": (
                "your own Antigravity conversations will ask again before commands outside the sandbox, "
                "reads/writes outside the workspace, MCP and URL tools; agy's agents keep running unattended; "
                "subagents spawned by agy's agents are NOT covered yet and will ask too"
            ),
            "how_to_undo": f"re-add absent wildcard grants to {cfg_path} and restore consent.json if moved",
            "prompt_notes": [
                "your own Antigravity conversations will ask again before commands outside the sandbox, reads/writes outside the workspace, MCP and URL tools",
                "agy's agents keep running unattended",
                "subagents spawned by agy's agents are NOT covered yet and will ask too",
            ],
        })

    if daemon is None:
        notes.append("daemon not running: plugin health not checked")
    else:
        data, kind, _detail = _rpc("GetMcpServerStates", {}, daemon)
        if kind != "ok" or data is None:
            notes.append(f"could not read MCP server states ({kind}): plugin health not checked")
        elif cfg_err is None and isinstance(cfg_data, dict):
            plugins = cfg_data.get("plugins") if isinstance(cfg_data.get("plugins"), dict) else {}
            enabled_plugins = sorted(
                k for k, v in plugins.items() if isinstance(v, dict) and v.get("enabled") is True
            )
            by_plugin = {}
            states = _unwrap(data).get("states") or []
            if isinstance(states, list):
                for st in states:
                    if not isinstance(st, dict):
                        continue
                    spec = st.get("spec") if isinstance(st.get("spec"), dict) else {}
                    pname = str(spec.get("pluginName") or "").strip()
                    if pname:
                        by_plugin.setdefault(pname, []).append(st)
            for pname in enabled_plugins:
                srvs = by_plugin.get(pname, [])
                if srvs and all(str(s.get("status") or "") == "MCP_SERVER_STATUS_ERROR" for s in srvs):
                    first_st = srvs[0]
                    first_spec = first_st.get("spec") if isinstance(first_st.get("spec"), dict) else {}
                    first_err = _redact_mcp_error(str(first_st.get("error") or ""), first_spec)[:120]
                    err_note = first_err or "MCP_SERVER_STATUS_ERROR"
                    actions.append({
                        "id": f"disable-broken-plugins:{pname}",
                        "kind": "disable-broken-plugins",
                        "plugin": pname,
                        "title": f"disable plugin {pname} (its {len(srvs)} MCP servers all fail; its skills are unloaded too)",
                        "default_yes": True,
                        "what": f"set plugins.{pname}.enabled = false in {cfg_path}",
                        "why": f"first error: {err_note}",
                        "how_to_undo": f"set plugins.{pname}.enabled back to true in {cfg_path} if still false",
                    })

    skill_src = _agy_skill_source()
    skill_bytes = None
    if skill_src.is_file():
        try:
            skill_bytes = skill_src.read_bytes()
        except OSError:
            skill_bytes = None
    if skill_bytes is None:
        notes.append("agy skill source not found; agents not taught")
    else:
        for host, _doc_name, display_name, home_fn in _SKILL_HOSTS:
            home = home_fn()
            if not home.is_dir():
                continue
            target = home / "skills" / "agy"
            state, info = _inspect_skill_target(target, skill_bytes)
            if state == "current":
                continue
            if state == "refuse":
                refusals.append(f"teach-{host}: {info}")
                continue
            if state == "symlink":
                what = f"replace symlink {target} -> {info} with a copy of {skill_src}"
                how_to_undo = f"remove {target / 'SKILL.md'} and restore symlink {target} -> {info}"
            elif state == "differs":
                what = f"back up and overwrite {target / 'SKILL.md'} from {skill_src}"
                how_to_undo = f"restore previous {target / 'SKILL.md'} from backup"
            else:
                what = f"copy {skill_src} -> {target / 'SKILL.md'}"
                how_to_undo = f"remove {target / 'SKILL.md'} and any directories created by setup"
            actions.append({
                "id": f"teach-{host}",
                "kind": "skill-installed",
                "host": host,
                "title": f"teach {display_name} to use agy (install the agy skill)",
                "default_yes": True,
                "what": what,
                "why": f"teaches {display_name} when and how to use agy",
                "how_to_undo": how_to_undo,
            })

    if not _api_key_present():
        actions.append({
            "id": "api-key",
            "kind": "api-key",
            "title": "configure a Gemini API key (for ask/img/tts/embed/video)",
            "default_yes": True,
            "what": (
                "find an existing Gemini API key (environment, ~/.gemini/.env, ~/.env, "
                "shell profiles, Keychain) or paste one; validate it with a free models "
                "list; store it in the Keychain"
            ),
            "why": "unlocks direct Gemini API commands (ask/img/tts/embed/video); agent dispatch needs no key",
            "how_to_undo": "delete the Keychain item setup created",
        })

    return actions, notes, refusals


def _render_setup_plan(actions: list, notes: list, refusals: list):
    print("== agy setup plan ==")
    for note in notes:
        print(f"  note: {note}")
    for ref in refusals:
        print(f"  refused: {ref}")
    total = len(actions)
