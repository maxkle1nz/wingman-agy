def _quota_bucket_group(mid: str, info: dict, groups: list):
    """Find the RetrieveUserQuotaSummary group for a model family, or None."""
    if not groups or info.get("disabled"):
        return None
    id_low = mid.lower()
    lbl_low = (info.get("label") or "").lower()
    prov = (info.get("provider") or "").upper()
    if "argon" in id_low or "argon" in lbl_low:
        for g in groups:
            name = (g.get("displayName") or "").lower()
            if "argon" in name or any("argon" in str(b.get("bucketId") or "").lower()
                                      for b in (g.get("buckets") or [])):
                return g
        return None
    if prov in ("ANTHROPIC", "OPENAI") or any(k in id_low or k in lbl_low for k in ("claude", "gpt")):
        for g in groups:
            text = f"{g.get('displayName') or ''} {g.get('description') or ''}".lower()
            if "claude" in text or "gpt" in text or any(
                    str(b.get("bucketId") or "").startswith("3p-") for b in (g.get("buckets") or [])):
                return g
        return None
    if prov == "GOOGLE" or "gemini" in id_low or "gemini" in lbl_low:
        for g in groups:
            name = (g.get("displayName") or "").lower()
            if "gemini" in name and "argon" not in name:
                return g
    return None


def _is_num(val) -> bool:
    return isinstance(val, (int, float)) and not isinstance(val, bool)


def _interpret_bucket(b: dict) -> dict:
    """Interpret a quota bucket (or quotaInfo dict) under the repo's zero-omission rule.

    Protobuf JSON omits zero values, so a missing or non-numeric remainingFraction
    means 0.0 (exhausted), never 'unknown'."""
    raw = b.get("remainingFraction")
    frac = float(raw) if _is_num(raw) else 0.0
    if frac < 0:
        frac = 0.0
    reset = str(b.get("resetTime") or "")
    return {
        "fraction": frac,
        "exhausted": frac <= 0,
        "reset": reset,
        "eta": _eta(reset),
    }


def _quota_from_group(group: dict, model_quota=None, *, inferred: bool = True):
    """Build a model's quota dict from its RetrieveUserQuotaSummary group.

    Every bucket is interpreted through _interpret_bucket so a missing
    remainingFraction means 0 (exhausted), matching `agy quota`."""
    buckets = [b for b in (group.get("buckets") or []) if isinstance(b, dict)]
    if not buckets:
        return model_quota
    interpreted = [(b, _interpret_bucket(b)) for b in buckets]
    primary_b, primary_info = min(interpreted, key=lambda pair: (
        pair[1]["fraction"],
        0 if str(pair[0].get("window") or "") == "5h" else 1,
    ))
    p_pct = round(primary_info["fraction"] * 100)
    extras = []
    for b, b_info in interpreted:
        if b is primary_b:
            continue
        b_pct = round(b_info["fraction"] * 100)
        if b_pct != p_pct:
            win = str(b.get("window") or b.get("bucketId") or "other")
            extras.append(f"{win} {b_pct:.0f}%")
    out = {
        "remainingFraction": primary_info["fraction"],
        "resetTime": primary_info["reset"],
    }
    if inferred:
        out["_inferred"] = True
    if extras:
        out["_extra"] = ", ".join(extras)
    return out


def _catalog(daemon: Daemon = None):
    """The live model catalog, or (None, reason) when it cannot be read.

    Returns ({"models": {id: info}, "tiers": {tier: id}, "default": id}, "") where info
    holds label, enum, provider, disabled, picker (shown in the app's model picker) and
    quota ({remainingFraction, resetTime} when the daemon gives it)."""
    avail, kind, detail = _rpc("GetAvailableModels", {}, daemon)
    config, _ckind, _cdetail = _rpc("GetCascadeModelConfigData", {}, daemon)
    if avail is None and config is None:
        return None, f"{kind}: {detail}"
    quota_data, _qkind, _qdetail = _rpc("RetrieveUserQuotaSummary", {}, daemon)
    quota_groups = _unwrap(quota_data).get("groups") or []
    if not isinstance(quota_groups, list):
        quota_groups = []
    models, tiers, default = {}, {}, ""
    a = _unwrap(avail)
    raw_models = a.get("models") or {}
    if isinstance(raw_models, list):  # tolerate a list shape as well as the map
        raw_models = {str(m.get("modelId") or m.get("id") or ""): m for m in raw_models
                      if isinstance(m, dict)}
    for mid, m in raw_models.items():
        if not mid or not isinstance(m, dict):
            continue
        models[mid] = {"label": str(m.get("displayName") or m.get("label") or ""),
                       "enum": str(m.get("model") or ""),
                       "provider": str(m.get("modelProvider") or "").replace("MODEL_PROVIDER_", ""),
                       "disabled": bool(m.get("disabled")), "picker": False, "quota": None}
    for k, v in (a.get("tieredModelIds") or {}).items():
        if k in _TIER_KEYS and isinstance(v, str) and v:
            tiers[_TIER_KEYS[k]] = v
    default = str(a.get("defaultAgentModelId") or "")
    for c in _picker_entries(_unwrap(config)):
        mid = c["modelId"]
        info = models.setdefault(mid, {"label": "", "enum": "", "provider": "",
                                       "disabled": False, "picker": False, "quota": None})
        info["picker"] = True
        info["label"] = c["label"] or info["label"]
        info["disabled"] = info["disabled"] or c["disabled"]
        if c["quota"] is not None:
            info["quota"] = c["quota"]
    if quota_groups:
        for mid, info in models.items():
            grp = _quota_bucket_group(mid, info, quota_groups)
            if grp is not None:
                info["quota"] = _quota_from_group(grp, info["quota"])
    if not models:
        return None, "the catalog reply carried no models"
    return {"models": models, "tiers": tiers, "default": default}, ""


def _picker_entries(config: dict) -> list:
    """Model rows of GetCascadeModelConfigData, wherever they sit in the reply: every
    dict carrying a string `modelId` and a `label`."""
    out, seen = [], set()

    def walk(o):
        if isinstance(o, dict):
            mid = o.get("modelId")
            if isinstance(mid, str) and mid and "label" in o and mid not in seen:
                seen.add(mid)
                q = o.get("quotaInfo")
                out.append({"modelId": mid, "label": str(o.get("label") or ""),
                            "disabled": bool(o.get("disabled")),
                            "quota": q if isinstance(q, dict) else None})
            for v in o.values():
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(config)
    return out


def _quota_phrase(q) -> str:
    if not isinstance(q, dict) or not q:
        return "-"
    info = _interpret_bucket(q)
    frac = info["fraction"]
    eta = info["eta"]
    reset = f"resets {'in ' + eta if eta not in ('now', '-') else eta}"
    phrase = f"{frac * 100:.0f}% left, {reset}"
    if q.get("_extra"):
        phrase += f" ({q['_extra']})"
    if q.get("_inferred"):
        phrase = "~" + phrase
    return phrase


def _cmd_models_catalog(args):
    d = discover()
    if args.raw:
        for method in ("GetAvailableModels", "GetCascadeModelConfigData", "RetrieveUserQuotaSummary"):
            data, kind, detail = _rpc(method, {}, d)
            print(f"== {method} ==")
            print(json.dumps(data, indent=2, ensure_ascii=False) if data is not None
                  else f"  failed ({kind}): {detail}")
        return
    cat, why = _catalog(d)
    if cat is None:
        die(f"could not read the live model catalog from the daemon: {why}\n"
            "(the old Gemini API listing is still at: agy models --api)", EXIT_NO_DAEMON)
    needle = (args.filter or "").lower()
    rows = sorted(cat["models"].items(), key=lambda kv: (not kv[1]["picker"], kv[0]))
    print(f"{'--model ID':<34} {'LABEL':<32} QUOTA")
    hidden = 0
    any_inferred = False
    for mid, m in rows:
        if needle and needle not in mid.lower() and needle not in m["label"].lower():
            continue
        if not m["picker"] and not args.all:
            hidden += 1
            continue
        if isinstance(m["quota"], dict) and m["quota"].get("_inferred"):
            any_inferred = True
        flags = " (DISABLED)" if m["disabled"] else ""
        flags += " (default)" if mid == cat["default"] else ""
        print(f"{mid:<34} {(m['label'] or '-')[:32]:<32} {_quota_phrase(m['quota'])}{flags}")
    if any_inferred:
        print("\n~ quota inferred from family bucket name heuristics")
    if cat["tiers"]:
        prefix = "" if any_inferred else "\n"
        print(f"{prefix}tiers (resolved server-side; prefer an exact id): " + ", ".join(
            f"{t} -> {cat['tiers'][t]}" for t in TIERS if t in cat["tiers"]))
    if hidden:
        print(f"{hidden} more catalog ids outside the agent picker: agy models --all")


def cmd_models(args):
    if args.api:
        return _cmd_models_api(args)
    return _cmd_models_catalog(args)


def _warn(msg: str):
    print(f"agy: {msg}", file=sys.stderr)


def _check_model(model: str, allow_fallback: bool, daemon: Daemon):
    """Pre-dispatch gate for `new --model`. Returns (catalog or None, expected id or None).

    expected is what the generator metadata should report afterwards: the id itself, the
    id a tier resolves to, or None when a tier cannot be resolved (nothing to compare).
    Refuses unknown/disabled ids and unreadable catalogs (exit 1) unless allow_fallback."""
    cat, why = _catalog(daemon)
    if model in TIERS:
        resolved = (cat or {}).get("tiers", {}).get(model)
        if resolved:
            label = cat["models"].get(resolved, {}).get("label")
            _warn(f"warning: --model {model} is a TIER, not a model: it runs {resolved}"
                  f"{f' ({label})' if label else ''} right now. Pin an exact id to choose "
                  "the model (see: agy models).")
        else:
            _warn(f"warning: --model {model}: tier, resolves server-side; usually flash. "
                  "Pin an exact id to choose the model (see: agy models).")
        return cat, resolved
    if cat is None:
        if allow_fallback:
            _warn(f"WARNING: could not read the live model catalog ({why}); "
                  f"--allow-fallback: dispatching '{model}' UNCHECKED — the app silently "
                  "runs the flash tier for an unknown id.")
            return None, model
        die(f"could not read the live model catalog ({why}); refusing to dispatch '{model}' "
            "unchecked.\n  Pass --allow-fallback to dispatch anyway.", EXIT_ERR)
    info = cat["models"].get(model)
    if info and not info["disabled"]:
        return cat, model
    reason = "is DISABLED in the live catalog" if info else "is not in the live catalog"
    if allow_fallback:
        _warn(f"WARNING: --model '{model}' {reason}; --allow-fallback: dispatching anyway. "
              "The app will most likely run the flash tier instead.")
        return cat, model
    near = difflib.get_close_matches(model, [m for m, i in cat["models"].items()
                                             if not i["disabled"]], n=3, cutoff=0.6)
    die(f"--model '{model}' {reason}: the app would silently run the flash tier instead.\n"
        + (f"  did you mean: {', '.join(near)}\n" if near else "")
        + "  See the exact ids with `agy models`, or pass --allow-fallback to dispatch anyway.",
        EXIT_ERR)


def _ran_models(data) -> list:
    """(responseModel, modelDisplayName) per generator call, in order, from
    GetCascadeTrajectoryGeneratorMetadata. Only the model fields are read: the same
    reply carries the agent's full system prompt, which agy never prints."""
    out = []
    gens = _unwrap(data).get("generatorMetadata")
    if not isinstance(gens, list):
        gens = []
    for g in gens:
        cm = g.get("chatModel") if isinstance(g, dict) else None
        if isinstance(cm, dict) and cm.get("responseModel"):
            out.append((str(cm["responseModel"]), str(cm.get("modelDisplayName") or "")))
    return out


def _generator_models(daemon: Daemon, conv: str):
    """(list of ran models, error detail) — error is "" when the RPC answered."""
    data, kind, detail = _rpc("GetCascadeTrajectoryGeneratorMetadata", {"cascadeId": conv}, daemon)
    if data is None:
        return [], f"{kind}: {detail}"
    return _ran_models(data), ""


def _await_ran_model(daemon: Daemon, conv: str, timeout: float, skip=0):
    """Poll until generator call number `skip` (0-based) reports a responseModel, for at
    most `timeout` seconds. Returns ((responseModel, modelDisplayName), error_detail)."""
    deadline = time.monotonic() + max(0.0, float(timeout))
    last_err = ""
    while True:
        ran, err = _generator_models(daemon, conv)
        if len(ran) > skip:
            return ran[skip], ""
        last_err = err
        if err.startswith(("app:", "auth:")):
            return None, err
        left = deadline - time.monotonic()
        if left <= 0:
            return None, last_err
        time.sleep(min(2.0, left))


def _model_matches(expected: str, ran, cat) -> bool:
    """responseModel equals the id, or its display name equals the catalog label. The
    label rule is needed: a proven gemini-4-argon-high pin reports responseModel
    gemini-4-argon-trial with modelDisplayName "Gemini 4 Argon (High)"."""
    response_model, display = ran
    if response_model == expected:
        return True
    label = ((cat or {}).get("models", {}).get(expected) or {}).get("label") or ""
    return bool(label and display and label.strip().lower() == display.strip().lower())


def _report_ran(requested: str, expected, ran, cat) -> int:
    """Print what ran; return EXIT_OK or EXIT_MODEL_MISMATCH."""
    response_model, display = ran
    _warn(f"ran: {display or '?'} ({response_model})")
    if expected is None:
        _warn(f"(requested tier '{requested}' could not be resolved, so there is nothing to compare)")
        return EXIT_OK
    if _model_matches(expected, ran, cat):
        return EXIT_OK
    want = requested if requested == expected else f"{requested} -> {expected}"
    bar = "!" * 72
    print(f"{bar}\nagy: MODEL MISMATCH: requested {want}, but the agent ran "
          f"{display or '?'} ({response_model}).\nagy: the app fell back silently. Do not "
          f"label this run as {requested}; stop it in the app if the model matters.\n{bar}",
          file=sys.stderr)
    return EXIT_MODEL_MISMATCH


def _eta(iso: str) -> str:
    """'resets in' from an ISO-8601 UTC instant — the absolute time alone does not answer
    the only question the owner has ("can I dispatch now or not?")."""
    if not iso:
        return "-"
    try:
        when = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return "-"
    secs = int((when - datetime.now(timezone.utc)).total_seconds())
    if secs <= 0:
        return "now"
    days, rem = divmod(secs, 86400)
    hours, rem = divmod(rem, 3600)
    if days:
        return f"{days}d {hours}h"
    return f"{hours}h {rem // 60}m" if hours else f"{rem // 60}m"


def _bar(frac: float, width=10) -> str:
    """A bucket with anything left NEVER renders as an empty bar: an empty bar must mean
    EXHAUSTED and nothing else, so rounding is not allowed to lie about that."""
    filled = 0 if frac <= 0 else max(1, min(width, int(round(frac * width))))
    return "[" + "#" * filled + "-" * (width - filled) + "]"


def cmd_quota(args):
    d = discover()
    data, kind, failures = None, "transport", []
    # Which sibling port serves TLS is PROVEN by the answer, exactly like discover()
    # proves the gRPC port — no guessing from the port number.
    for port in _quota_ports(d):
        data, kind, detail = _quota_rpc(port, d.token)
        if data is not None:
            break
        failures.append(f"127.0.0.1:{port}: {detail}")
    if data is None:
        die("could not read the quota from the daemon:\n  " + "\n  ".join(failures) +
            "\nAn app update may have renamed the RPC (" + QUOTA_RPC.split("/")[-1] + ").",
            _exit_code_for(kind))
    if args.raw:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return
    groups = (data.get("response") or data).get("groups") or []
    if not groups:
        die("quota reply carries no groups: {}".format(json.dumps(data)[:200]), EXIT_ERR)
    print("== plan quota (live from the Antigravity session) ==")
    for g in groups:
        models = str(g.get("description") or "")
        models = models.split(":", 1)[1].strip() if models.startswith("Models within") else models
        print("\n{}{}".format(g.get("displayName") or "?", f" — {models}" if models else ""))
        for b in g.get("buckets") or []:
            info = _interpret_bucket(b)
            frac = info["fraction"]
            reset = info["reset"]
            when = f"({reset[:16].replace('T', ' ')}Z)" if reset else ""
            eta = info["eta"]
            phrase = {"now": "resets now", "-": "reset time unknown"}.get(eta, f"resets in {eta}")
            print("  {} {:<16} {:>6}  {}  {:<27} {}".format(
                "!" if info["exhausted"] else " ",
                b.get("displayName") or b.get("bucketId") or "?",
                f"{frac * 100:.1f}%", _bar(frac),
                ("EXHAUSTED, " + phrase) if info["exhausted"] else phrase, when))
            # Only for a spent bucket: there the server's own sentence carries what our
            # arithmetic cannot (credits, which limit actually blocks you).
            if info["exhausted"] and b.get("description"):
                print(textwrap.fill(" ".join(str(b["description"]).split()), width=78,
                                    initial_indent="      ", subsequent_indent="      "))


# --------------------------------------------------------------------------- gemini api

def _api_account() -> str:
    if API_ACCOUNT != _INIT_API_ACCOUNT:
        return API_ACCOUNT
    return os.environ.get("AGY_API_KEY_ACCOUNT") or getpass.getuser()


def _api_key(required=True) -> str:
    """Env override first (explicit intent beats stored state), then the Keychain.
    Read fresh per run and never returned to any output path — same discipline the
    CSRF token gets above."""
    env = os.environ.get("GEMINI_API_KEY", "").strip()
    if env:
        return env
    account = _api_account()
    for service in API_KEY_SERVICES:
        for cmd in (
            ["security", "find-generic-password", "-s", service, "-a", account, "-w"],
            ["security", "find-generic-password", "-s", service, "-w"],
        ):
            try:
                r = _run(cmd)
            except (OSError, subprocess.SubprocessError):
                continue
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
    if required:
        die(f"gemini api key not found in Keychain ({API_KEY_SERVICES[0]}/{account})", EXIT_AUTH)
    return ""


def _api_key_present() -> bool:
    """Attribute-only Keychain presence check (never passes `-w` and never prompts to unlock)."""
    if os.environ.get("GEMINI_API_KEY", "").strip():
        return True
    account = _api_account()
    for service in API_KEY_SERVICES:
        for cmd in (
            ["security", "find-generic-password", "-s", service, "-a", account],
            ["security", "find-generic-password", "-s", service],
        ):
            try:
                r = _run(cmd)
            except (OSError, subprocess.SubprocessError):
                continue
            if r.returncode == 0:
                return True
    return False


def _die_http(e, what: str):
    """Short and key-free — the message comes from the reply body, which never carries
    the credential because the credential never left the header.

    A credential problem must be distinguishable from a bad request, and the status
    code alone does not do it: measured live, an invalid key answers **400
    INVALID_ARGUMENT** (not 401/403) and only the google.rpc.ErrorInfo `reason` says
    API_KEY_INVALID. So both signals map to EXIT_AUTH."""
    msg, body = "", {}
    try:
        body = json.loads(e.read().decode("utf-8", "replace"))
        if isinstance(body, dict):
            msg = str(body.get("error", {}).get("message", ""))[:300]
    except (OSError, ValueError):
        body = {}
    key_problem = any(r.startswith("API_KEY") for r in _find(body, "reason"))
    die(f"gemini api HTTP {e.code} on {what}: {msg or e.reason}",
        EXIT_AUTH if e.code in (401, 403) or key_problem else EXIT_ERR)


def _api_open(path: str, payload=None, timeout=None):
    """One call to the Gemini API; the caller closes the response.

    The key goes in the x-goog-api-key HEADER and never in the query string: a URL
    ends up in proxy logs, shell history and error text, a header does not."""
    what = path.split("?")[0]
    req = urllib.request.Request(
        f"{API_BASE}/{path}",
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={"x-goog-api-key": _api_key(), "content-type": "application/json"})
    try:
        return urllib.request.urlopen(req, timeout=timeout or API_TIMEOUT)
    except urllib.error.HTTPError as e:
        _die_http(e, what)
    except OSError as e:
        die(f"gemini api unreachable on {what}: {getattr(e, 'reason', e)}", EXIT_ERR)


def _api_json(path: str, payload=None, timeout=None) -> dict:
    with _api_open(path, payload, timeout) as r:
        try:
            return json.loads(r.read().decode("utf-8", "replace"))
        except (json.JSONDecodeError, ValueError):
            die(f"gemini api returned non-JSON on {path.split('?')[0]}", EXIT_ERR)


def _stdin_or(value) -> str:
    """Missing or '-' means stdin, so `cat file | agy ask -` composes like any unix tool.
    An ABSENT prompt on a terminal is a mistake, not a request to type one: say so
    instead of hanging on a read nobody expected. Explicit '-' still means "I'll type it"."""
    if value and value != "-":
        return value
    if value is None and sys.stdin.isatty():
        die("no prompt: pass it as an argument, pipe it in, or use '-' to type it")
    text = sys.stdin.read().strip()
    if not text:
        die("empty prompt (pass it as an argument or pipe it on stdin)")
    return text


def _load_schema(src: str) -> dict:
    try:
        raw = sys.stdin.read() if src == "-" else Path(src).expanduser().read_text()
        return json.loads(raw)
    except OSError as e:
        die(f"--json schema unreadable: {e}")
    except (json.JSONDecodeError, ValueError) as e:
        die(f"--json schema is not valid JSON: {e}")


def _human(size: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024


def _upload_part(spec: str) -> dict:
    """Upload one file to the Files API and return the `fileData` part that references it.

    The file is stored by Google for 48h (said in --help: it changes the decision for a
    sensitive document). The key travels in the same x-goog-api-key header as everything
    else here — never in the URL."""
    p = Path(spec).expanduser()
    if not p.is_file():
        die(f"--file not found: {p}" if not p.exists() else f"--file is not a file: {p}")
    try:
        data = p.read_bytes()
    except OSError as e:
        die(f"--file unreadable: {e}")
    mime = mimetypes.guess_type(p.name)[0]
    if not mime:
        mime = "application/octet-stream"
        print(f"agy: unknown type for {p.name} — sending as {mime}; the model may refuse it",
              file=sys.stderr)
    req = urllib.request.Request(UPLOAD_URL, data=data, headers={
        "x-goog-api-key": _api_key(),
        "X-Goog-Upload-Protocol": "raw",
        # Headers are latin-1 on the wire: a non-ASCII filename would raise here instead
        # of uploading. The display name is cosmetic, so we degrade it rather than fail.
        "X-Goog-Upload-Display-Name": p.name.encode("ascii", "replace").decode(),
        "Content-Type": mime})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            reply = json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        _die_http(e, f"file upload ({p.name})")
    except (OSError, ValueError) as e:
        die(f"file upload failed for {p.name}: {getattr(e, 'reason', e)}", EXIT_ERR)
    f = reply.get("file") or reply
    # Big media (video, long audio) lands as PROCESSING and is REFUSED by generateContent
    # until it turns ACTIVE — polling here is what makes `--file clip.mp4` work at all.
    deadline = time.time() + FILE_WAIT
    while str(f.get("state") or "ACTIVE") == "PROCESSING":
        name = str(f.get("name") or "")
        if not name:
            die(f"{p.name} is PROCESSING but the reply carries no name to poll: "
                f"{json.dumps(f)[:200]}", EXIT_ERR)
        if time.time() > deadline:
            die(f"{p.name} still PROCESSING after {FILE_WAIT}s (raise AGY_FILE_WAIT)", EXIT_ERR)
        time.sleep(2)
        got = _api_json(name, timeout=30)
        f = got.get("file") or got
    state = str(f.get("state") or "ACTIVE")
    if state != "ACTIVE":
        err = (f.get("error") or {}).get("message") or json.dumps(f.get("error") or {})[:200]
        die(f"{p.name} is {state} on the server: {err}", EXIT_ERR)
    uri = str(f.get("uri") or "")
    if not uri:
        die(f"the Files API returned no uri for {p.name}: {json.dumps(f)[:200]}", EXIT_ERR)
    print("agy: sent {} ({}, {}) as {}".format(
        p.name, f.get("mimeType") or mime, _human(len(data)), f.get("name") or uri),
        file=sys.stderr)
    return {"fileData": {"fileUri": uri, "mimeType": str(f.get("mimeType") or mime)}}


def _render_parts(parts: list) -> str:
    """Text plus code-execution parts, rendered readable: dropping executableCode and
    codeExecutionResult would hide the actual work `--exec` paid for. Parts carrying
    only a thoughtSignature (empty text) are not output and are skipped."""
    out = []
    for p in parts:
        if p.get("thought"):
            continue
        if p.get("text"):
            out.append(p["text"])
        code = p.get("executableCode") or {}
        if code.get("code"):
            out.append("\n```{}\n{}\n```\n".format(
                str(code.get("language", "")).lower(), code["code"].strip()))
        res = p.get("codeExecutionResult") or {}
        if res:
            out.append("[{}]\n{}\n".format(res.get("outcome", "?"), res.get("output", "")))
    return "".join(out)


def _warn_grounding(cand: dict):
    q = (cand.get("groundingMetadata") or {}).get("webSearchQueries") or []
    if q:
        print("agy: grounded on: " + " | ".join(str(x) for x in q), file=sys.stderr)


def _warn_finish(cand: dict, usage: dict):
    """Anything the caller must KNOW goes to stderr so stdout stays pipe-clean. An
    answer cut short by the token cap looks exactly like a short answer — say so."""
    fin = str(cand.get("finishReason") or "")
    if not fin or fin == "STOP":
        return
    extra = ""
    if fin == "MAX_TOKENS":
        extra = (" — {} thinking + {} answer tokens hit the cap; raise --max-tokens".format(
            usage.get("thoughtsTokenCount", 0), usage.get("candidatesTokenCount", 0)))
    print(f"agy: incomplete answer (finishReason={fin}){extra}", file=sys.stderr)


def _first_candidate(reply: dict) -> dict:
    cands = reply.get("candidates") or []
    if not cands:
        fb = reply.get("promptFeedback") or {}
        die("gemini returned no candidates (blockReason={})".format(fb.get("blockReason", "none")),
            EXIT_ERR)
    return cands[0]


def _ext_for(mime: str) -> str:
    """The extension follows the mimeType the API ACTUALLY returned: a .jpg holding
    PNG bytes is a lie the next tool in the pipe pays for."""
    sub = mime.split("/")[-1].split(";")[0].strip().lower()
    return "." + {"jpeg": "jpg", "mpeg": "mp3", "quicktime": "mov", "x-wav": "wav"}.get(sub, sub)


def _write_blob(out: str, blob: dict) -> str:
    p = Path(out).expanduser()
    ext = _ext_for(str(blob.get("mimeType", "")))
    if len(ext) > 1 and p.suffix.lower() != ext:
        print(f"agy: saving as {ext} — the API returned {blob.get('mimeType')}", file=sys.stderr)
        p = p.with_suffix(ext)
    try:
        data = base64.b64decode(blob.get("data") or "")
    except ValueError as e:
        die(f"gemini returned undecodable base64: {e}", EXIT_ERR)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_bytes(data)
    return str(p)


def _write_wav(out: str, mime: str, pcm: bytes) -> str:
    """`audio/l16` is RAW 16-bit little-endian PCM, NOT a WAV: writing those bytes into
    a .wav produces a file no player opens. Rate and channels are parsed from the reply
    instead of hardcoded — the model is free to change them under us."""
    channels, rate = 1, 24000
    for field in mime.split(";")[1:]:
        k, _, v = field.partition("=")
        k, v = k.strip().lower(), v.strip()
        if not v.isdigit():
            continue
        if k == "rate":
            rate = int(v)
        elif k == "channels":
            channels = int(v)
    p = Path(out).expanduser().with_suffix(".wav")
    p.parent.mkdir(parents=True, exist_ok=True)
    with wave.open(str(p), "wb") as w:
        w.setnchannels(channels)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(pcm)
    return str(p)


def _inline_blob(parts: list) -> dict:
    return next((p["inlineData"] for p in parts if p.get("inlineData")), {})


def cmd_ask(args):
    # Prompt FIRST: a missing prompt must fail before any byte is uploaded. Attachments
    # come BEFORE the text in `parts` — the documented order for multimodal prompts.
    prompt = _stdin_or(args.prompt)
    parts = [_upload_part(f) for f in (args.file or [])] + [{"text": prompt}]
    body = {"contents": [{"role": "user", "parts": parts}],
            "generationConfig": {"maxOutputTokens": args.max_tokens}}
    if args.json:
        body["generationConfig"]["responseMimeType"] = "application/json"
        body["generationConfig"]["responseSchema"] = _load_schema(args.json)
    if args.system:
        body["systemInstruction"] = {"parts": [{"text": args.system}]}
    tools = ([{"googleSearch": {}}] if args.search else []) \
        + ([{"codeExecution": {}}] if args.exec else []) \
        + ([{"urlContext": {}}] if args.url else [])
    if tools:
        body["tools"] = tools
    if args.stream:
        return _ask_stream(args, body)

    reply = _api_json(f"models/{args.model}:generateContent", body)
    if args.raw:
        print(json.dumps(reply, indent=2, ensure_ascii=False))
        return
    cand = _first_candidate(reply)
    text = _render_parts((cand.get("content") or {}).get("parts") or [])
    _warn_grounding(cand)
    _warn_finish(cand, reply.get("usageMetadata") or {})
    if not text.strip():
        # A caller trusting the exit code must never read an empty stdout as a success.
        die("gemini returned an empty answer", EXIT_ERR)
    print(text.rstrip())


def _ask_stream(args, body):
    """Print each chunk as it lands — consuming the whole body first would defeat the
    only reason to stream. Parts with empty text (thoughtSignature carriers) yield
    nothing, so the stream stays silent until real output starts."""
    printed, cand, usage = False, {}, {}
    with _api_open(f"models/{args.model}:streamGenerateContent?alt=sse", body) as r:
        for line in r:
            line = line.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            try:
                chunk = json.loads(line[5:].strip())
            except (json.JSONDecodeError, ValueError):
                continue
            if args.raw:
                print(json.dumps(chunk, ensure_ascii=False), flush=True)
                printed = True
                continue
            usage = chunk.get("usageMetadata") or usage
            for c in chunk.get("candidates") or []:
                cand = c
                text = _render_parts((c.get("content") or {}).get("parts") or [])
                if text:
                    print(text, end="", flush=True)
                    printed = True
    if printed and not args.raw:
        print()
    _warn_grounding(cand)
    _warn_finish(cand, usage)
    if not printed:
        die("gemini streamed no output", EXIT_ERR)


def cmd_img(args):
    reply = _api_json(f"models/{args.model}:generateContent", {
        "contents": [{"role": "user", "parts": [{"text": _stdin_or(args.prompt)}]}],
        "generationConfig": {"responseModalities": ["IMAGE", "TEXT"]}})
