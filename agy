def _inspect_skill_target(target: Path, src_bytes):
    """Classify <host home>/skills/agy read-only: (state, info)."""
    skills_dir = target.parent
    if skills_dir.is_symlink():
        try:
            resolved = skills_dir.resolve()
        except (OSError, RuntimeError):  # RuntimeError: symlink loop on Python < 3.13
            try:
                resolved = os.readlink(skills_dir)
            except OSError:
                resolved = "<unreadable>"
        return "refuse", f"{skills_dir} is a symlink to {resolved}; will not write through it"
    if skills_dir.exists() and not skills_dir.is_dir():
        return "refuse", f"{skills_dir} exists and is not a directory; will not overwrite it"
    if target.is_symlink():
        try:
            old_target = os.readlink(target)
        except OSError as e:
            return "refuse", f"cannot read symlink {target}: {e}"
        return "symlink", old_target
    if not target.exists():
        return "absent", None
    if not target.is_dir():
        return "refuse", f"{target} exists as a regular file; will not overwrite it"
    try:
        entries = list(target.iterdir())
    except OSError as e:
        return "refuse", f"cannot read {target}: {e}"
    real_entries = [e for e in entries if not _is_ignorable_skill_entry(e)]
    if not real_entries:
        return "empty_dir", None
    if len(real_entries) == 1 and real_entries[0].name == "SKILL.md":
        sf = real_entries[0]
        if sf.is_symlink() or not sf.is_file():
            return "refuse", f"{sf} is not a regular file; will not overwrite it"
        try:
            cur_bytes = sf.read_bytes()
        except OSError as e:
            return "refuse", f"cannot read {sf}: {e}"
        if src_bytes is not None and cur_bytes == src_bytes:
            return "current", None
        return "differs", None
    return "refuse", f"{target} exists with other entries; will not overwrite it"


