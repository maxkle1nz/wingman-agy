# gemini-3.8-flash-tiered, and unknown ids (claude-opus-5-5-max) silently fall back to
# the flash tier. agentapi never says so. The live catalog is the only way to refuse a
# bad id BEFORE spending quota, and the generator metadata the only way to see what ran.

TIERS = ("flash_lite", "flash", "pro")
# GetAvailableModels.tieredModelIds uses camelCase keys.
